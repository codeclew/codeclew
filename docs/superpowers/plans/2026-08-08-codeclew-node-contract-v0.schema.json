{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/node-contract-v0.schema.json",
  "title": "Codeclew bootstrap NodeContract v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planStatus",
    "manifestScope",
    "manifests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "codeclew-node-contract/0"
    },
    "planStatus": {
      "const": "PROPOSED_AWAITING_HUMAN_APPROVAL"
    },
    "manifestScope": {
      "const": ["R01", "R02", "R03", "GK"]
    },
    "manifests": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "id": { "const": "R01" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "id": { "const": "R02" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "id": { "const": "R03" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "id": { "const": "GK" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/manifest"
      }
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "kind",
        "goal",
        "hypothesisIds",
        "hardPredecessors",
        "readFirst",
        "boundedWork",
        "nonGoals",
        "expectedEvidenceDelta",
        "outputArtifacts",
        "genericOutcomeArtifacts",
        "verificationCommands",
        "independentVerifierChecks",
        "requiredCheckIds",
        "budgets",
        "retryPolicy",
        "retryableGenericBranchCodes",
        "passPredicate",
        "allowedOutcomes",
        "branchCodes"
      ],
      "properties": {
        "id": {
          "enum": ["R01", "R02", "R03", "GK"]
        },
        "status": {
          "const": "BLOCKED_ON_A00"
        },
        "kind": {
          "enum": ["CONTRACT", "AUDIT"]
        },
        "goal": {
          "type": "string",
          "minLength": 20
        },
        "hypothesisIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(ALL|H(0[1-9]|1[0-4]))$"
          },
          "uniqueItems": true
        },
        "hardPredecessors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "readFirst": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "boundedWork": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "nonGoals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expectedEvidenceDelta": {
          "type": "string",
          "minLength": 20
        },
        "outputArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "genericOutcomeArtifacts": {
          "description": "Minimal immutable diagnostic packet allowed when work terminates before the success output set exists.",
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 3
          },
          "uniqueItems": true
        },
        "verificationCommands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "independentVerifierChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "requiredCheckIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "uniqueItems": true
        },
        "budgets": {
          "$ref": "#/$defs/budgets"
        },
        "retryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxProducerAttempts", "maxInfrastructureReruns", "noProgressRule"],
          "properties": {
            "maxProducerAttempts": {
              "const": 2
            },
            "maxInfrastructureReruns": {
              "const": 1
            },
            "noProgressRule": {
              "const": "same failure fingerprint twice without accepted evidence delta"
            }
          }
        },
        "retryableGenericBranchCodes": {
          "description": "Exact manifest-owned generic branch allowlist that may authorize producer attempt 2; NONE and BUDGET_EXCEEDED are forbidden.",
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^(REWORK|REVISE)_[A-Z0-9_]+$",
            "not": {
              "enum": ["NONE", "BUDGET_EXCEEDED"]
            }
          },
          "uniqueItems": true
        },
        "passPredicate": {
          "type": "string",
          "minLength": 20
        },
        "allowedOutcomes": {
          "type": "array",
          "contains": {
            "const": "SUCCESS"
          },
          "items": {
            "enum": ["SUCCESS", "FAILURE", "REFUSED", "BLOCKED", "NO_PROGRESS", "INFRA_ERROR"]
          },
          "uniqueItems": true
        },
        "branchCodes": {
          "type": "array",
          "minItems": 2,
          "contains": {
            "const": "NONE"
          },
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noncachedTokenCeiling",
        "outputTokenCeiling",
        "toolCallCeiling",
        "wallMinutesCeiling",
        "perTurnVisibleContextBytes"
      ],
      "properties": {
        "noncachedTokenCeiling": {
          "type": "integer",
          "minimum": 1
        },
        "outputTokenCeiling": {
          "type": "integer",
          "minimum": 1
        },
        "toolCallCeiling": {
          "type": "integer",
          "minimum": 1
        },
        "wallMinutesCeiling": {
          "type": "integer",
          "minimum": 1
        },
        "perTurnVisibleContextBytes": {
          "const": 65536
        }
      }
    }
  }
}
