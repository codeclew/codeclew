{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/verification-receipt-v0.schema.json",
  "title": "Codeclew bootstrap VerificationReceipt v0",
  "description": "Planning-time independent-verification receipt used by R01, R02, R03 and the terminal-only bootstrap profile of GK before VerificationReceipt v1 exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetDigest",
    "approvalBundleDigest",
    "runManifestDigest",
    "nodeId",
    "attempt",
    "verifier",
    "producerSessionId",
    "independenceAttestation",
    "checks",
    "verdict",
    "packetOutcome",
    "packetBranchCode",
    "costAccounting",
    "limitations",
    "verifiedAt",
    "digestScope",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "codeclew-verification-receipt/0"
    },
    "packetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvalBundleDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runManifestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nodeId": {
      "enum": ["R01", "R02", "R03", "GK"]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "sessionId", "modelVersion", "toolVersions"],
      "properties": {
        "agentId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "toolVersions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "producerSessionId": {
      "type": "string",
      "minLength": 1
    },
    "independenceAttestation": {
      "const": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "result", "evidenceRef", "explanation"],
        "properties": {
          "checkId": { "type": "string", "minLength": 1 },
          "result": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
          "evidenceRef": { "$ref": "#/$defs/digestRef" },
          "explanation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verdict": {
      "enum": ["ACCEPT", "ACCEPT_EXPLORATORY_ONLY", "REJECT_RETRYABLE", "REJECT_FATAL", "BLOCKED_EXTERNAL"]
    },
    "packetOutcome": {
      "enum": ["SUCCESS", "FAILURE", "REFUSED", "BLOCKED", "NO_PROGRESS", "INFRA_ERROR"]
    },
    "packetBranchCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "costAccounting": {
      "$ref": "#/$defs/costAccounting"
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verifiedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "digestScope": {
      "const": "RFC8785_CANONICAL_JSON_WITHOUT_RECEIPT_DIGEST"
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "enum": ["ACCEPT", "ACCEPT_EXPLORATORY_ONLY"] } },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "result": { "const": "PASS" } },
              "required": ["result"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "nodeId": { "const": "R01" } }, "required": ["nodeId"] },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "prefixItems": [
              { "type": "object", "properties": { "checkId": { "const": "SOURCE_DIGESTS" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "MANDATORY_TRACE_COVERAGE" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "UNVERIFIED_SOURCE_GATE_EXCLUSION" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "CROSS_LANGUAGE_SCAFFOLD_BOUNDARY" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "CLICKABLE_EVIDENCE_PROTOTYPE" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "TEAM_BUDGET_ENFORCEMENT" } }, "required": ["checkId"] }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "nodeId": { "const": "R02" } }, "required": ["nodeId"] },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "prefixItems": [
              { "type": "object", "properties": { "checkId": { "const": "NEGATIVE_PACKET_REJECTION" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "TEAM_TOKEN_RECONCILIATION" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "TOKEN_UNAVAILABLE_BRANCH" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "DOT_VOCABULARY_CLOSURE" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "FINAL_FREEZE_REPORT_CONTRACTS" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "TEAM_BUDGET_ENFORCEMENT" } }, "required": ["checkId"] }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "nodeId": { "const": "R03" } }, "required": ["nodeId"] },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              { "type": "object", "properties": { "checkId": { "const": "BASELINE_REPRODUCTION" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "CAPABILITY_GAP_SAMPLE" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "STORAGE_ADR_THRESHOLD" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "TEAM_BUDGET_ENFORCEMENT" } }, "required": ["checkId"] }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "nodeId": { "const": "GK" } }, "required": ["nodeId"] },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              { "type": "object", "properties": { "checkId": { "const": "FOUNDATION_EXHAUSTED_SOURCE_SET" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "INCONCLUSIVE_FOUNDATION_NORMALIZATION" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "NO_IMPLEMENTATION_UNLOCK" } }, "required": ["checkId"] },
              { "type": "object", "properties": { "checkId": { "const": "TEAM_BUDGET_ENFORCEMENT" } }, "required": ["checkId"] }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "attempt": { "const": 1 } }, "required": ["attempt"] },
      "then": {
        "properties": {
          "costAccounting": {
            "type": "object",
            "properties": {
              "priorAttemptReceipts": { "type": "array", "maxItems": 0 }
            },
            "required": ["priorAttemptReceipts"]
          }
        }
      }
    },
    {
      "if": { "properties": { "attempt": { "const": 2 } }, "required": ["attempt"] },
      "then": {
        "properties": {
          "costAccounting": {
            "type": "object",
            "properties": {
              "priorAttemptReceipts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {
                    "type": "object",
                    "properties": { "attempt": { "const": 1 } },
                    "required": ["attempt"]
                  }
                ]
              }
            },
            "required": ["priorAttemptReceipts"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "priorAttemptReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "packetRef", "receiptRef", "packetSelfRef", "summarySelfRef"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "maximum": 1 },
        "packetRef": { "$ref": "#/$defs/digestRef" },
        "receiptRef": { "$ref": "#/$defs/digestRef" },
        "packetSelfRef": { "$ref": "#/$defs/digestRef" },
        "summarySelfRef": { "$ref": "#/$defs/digestRef" }
      }
    },
    "nullableNonnegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeTokenTelemetryAvailable",
        "inputTokens",
        "cachedInputTokens",
        "outputTokens",
        "noncachedTokens",
        "toolCalls",
        "wallMilliseconds",
        "visibleContextBytes"
      ],
      "properties": {
        "nativeTokenTelemetryAvailable": { "type": "boolean" },
        "inputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "cachedInputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "noncachedTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "wallMilliseconds": { "type": "integer", "minimum": 0 },
        "visibleContextBytes": { "type": "integer", "minimum": 0, "maximum": 65536 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "nativeTokenTelemetryAvailable": { "const": true } },
            "required": ["nativeTokenTelemetryAvailable"]
          },
          "then": {
            "properties": {
              "inputTokens": { "type": "integer" },
              "cachedInputTokens": { "type": "integer" },
              "outputTokens": { "type": "integer" },
              "noncachedTokens": { "type": "integer" }
            }
          }
        },
        {
          "if": {
            "properties": { "nativeTokenTelemetryAvailable": { "const": false } },
            "required": ["nativeTokenTelemetryAvailable"]
          },
          "then": {
            "properties": {
              "inputTokens": { "type": "null" },
              "cachedInputTokens": { "type": "null" },
              "outputTokens": { "type": "null" },
              "noncachedTokens": { "type": "null" }
            }
          }
        }
      ]
    },
    "teamTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeTokenTelemetryAvailable",
        "inputTokens",
        "cachedInputTokens",
        "outputTokens",
        "noncachedTokens",
        "toolCalls",
        "teamWallMilliseconds",
        "maxVisibleContextBytes"
      ],
      "properties": {
        "nativeTokenTelemetryAvailable": { "type": "boolean" },
        "inputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "cachedInputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "noncachedTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "teamWallMilliseconds": { "type": "integer", "minimum": 0 },
        "maxVisibleContextBytes": { "type": "integer", "minimum": 0, "maximum": 65536 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "nativeTokenTelemetryAvailable": { "const": true } },
            "required": ["nativeTokenTelemetryAvailable"]
          },
          "then": {
            "properties": {
              "inputTokens": { "type": "integer" },
              "cachedInputTokens": { "type": "integer" },
              "outputTokens": { "type": "integer" },
              "noncachedTokens": { "type": "integer" }
            }
          }
        },
        {
          "if": {
            "properties": { "nativeTokenTelemetryAvailable": { "const": false } },
            "required": ["nativeTokenTelemetryAvailable"]
          },
          "then": {
            "properties": {
              "inputTokens": { "type": "null" },
              "cachedInputTokens": { "type": "null" },
              "outputTokens": { "type": "null" },
              "noncachedTokens": { "type": "null" }
            }
          }
        }
      ]
    },
    "costAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budgetRefDigest",
        "producerTelemetryDigest",
        "verifierTelemetry",
        "priorAttemptReceipts",
        "teamTotals",
        "budgetStatus",
        "exceededMetrics"
      ],
      "properties": {
        "budgetRefDigest": { "$ref": "#/$defs/sha256" },
        "producerTelemetryDigest": { "$ref": "#/$defs/sha256" },
        "verifierTelemetry": { "$ref": "#/$defs/telemetry" },
        "priorAttemptReceipts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/priorAttemptReceipt" }
        },
        "teamTotals": { "$ref": "#/$defs/teamTotals" },
        "budgetStatus": {
          "enum": ["WITHIN", "EXCEEDED", "TOKEN_TELEMETRY_UNAVAILABLE"]
        },
        "exceededMetrics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "NONCACHED_TOKENS",
              "OUTPUT_TOKENS",
              "TOOL_CALLS",
              "WALL_MILLISECONDS",
              "VISIBLE_CONTEXT_BYTES"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "budgetStatus": { "const": "WITHIN" } },
            "required": ["budgetStatus"]
          },
          "then": {
            "properties": {
              "teamTotals": {
                "type": "object",
                "properties": { "nativeTokenTelemetryAvailable": { "const": true } },
                "required": ["nativeTokenTelemetryAvailable"]
              },
              "exceededMetrics": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "budgetStatus": { "const": "TOKEN_TELEMETRY_UNAVAILABLE" } },
            "required": ["budgetStatus"]
          },
          "then": {
            "properties": {
              "teamTotals": {
                "type": "object",
                "properties": { "nativeTokenTelemetryAvailable": { "const": false } },
                "required": ["nativeTokenTelemetryAvailable"]
              },
              "exceededMetrics": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "budgetStatus": { "const": "EXCEEDED" } },
            "required": ["budgetStatus"]
          },
          "then": {
            "properties": { "exceededMetrics": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    }
  }
}
