{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/evidence-packet-v0.schema.json",
  "title": "Codeclew bootstrap EvidencePacket v0",
  "description": "Planning-time packet contract used by R01, R02, R03 and the terminal-only bootstrap profile of GK before EvidencePacket v1 exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "nodeId",
    "attempt",
    "startedAt",
    "producerCompletedAt",
    "outcome",
    "branchCode",
    "limitations",
    "hypothesisIds",
    "producer",
    "approvalBundleDigest",
    "runManifestDigest",
    "sourceDigests",
    "parentReceiptDigests",
    "artifactSetDigest",
    "metricEligibility",
    "claims",
    "evidenceDelta",
    "telemetry",
    "artifacts",
    "humanReadableConclusion",
    "proposedNextEdges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "codeclew-evidence-packet/0"
    },
    "nodeId": {
      "enum": ["R01", "R02", "R03", "GK"]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "startedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "producerCompletedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "branchCode": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "hypothesisIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(ALL|H(0[1-9]|1[0-4]))$"
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "sessionId", "modelVersion", "toolVersions"],
      "properties": {
        "agentId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "toolVersions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approvalBundleDigest": {
      "$ref": "#/$defs/sha256"
    },
    "runManifestDigest": {
      "$ref": "#/$defs/sha256"
    },
    "sourceDigests": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "type": "object", "properties": { "role": { "const": "S0" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "role": { "const": "S1" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "role": { "const": "S2" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "role": { "const": "S3" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "role": { "const": "S4" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "role": { "const": "S5" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 }
      ],
      "items": { "$ref": "#/$defs/sourceDigestRef" }
    },
    "parentReceiptDigests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digestRef" }
    },
    "artifactSetDigest": {
      "$ref": "#/$defs/sha256"
    },
    "metricEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nativeTokens"],
      "properties": {
        "nativeTokens": { "enum": ["AVAILABLE", "UNAVAILABLE"] }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "evidenceDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "statement", "domains", "artifactRefs"],
      "properties": {
        "kind": {
          "enum": [
            "GAP_CLOSED",
            "HYPOTHESIS_UPDATED",
            "PREREQUISITE_CREATED",
            "OUTCOME_OBSERVED",
            "SUPPORTED_CONTOUR_NARROWED"
          ]
        },
        "statement": { "type": "string", "minLength": 20 },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claimDomain" }
        },
        "artifactRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digestRef" }
        }
      }
    },
    "telemetry": {
      "$ref": "#/$defs/telemetry"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "humanReadableConclusion": {
      "type": "string",
      "minLength": 20,
      "maxLength": 16384
    },
    "proposedNextEdges": {
      "description": "Producer hint only; the controller derives authoritative effectiveEligibleNextEdges from the frozen DOT.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "nodeId": { "const": "R01" } }, "required": ["nodeId"] },
      "then": {
        "properties": {
          "branchCode": {
            "enum": ["NONE", "REVISE_PLAN_SOURCE_COVERAGE", "BLOCK_UNVERIFIED_PROVENANCE", "BUDGET_EXCEEDED"]
          }
        }
      }
    },
    {
      "if": { "properties": { "nodeId": { "const": "R02" } }, "required": ["nodeId"] },
      "then": {
        "properties": {
          "branchCode": {
            "enum": ["NONE", "TOKEN_TELEMETRY_UNAVAILABLE", "BLOCK_MEASUREMENT_CONTRACT", "REWORK_EVIDENCE_SCHEMA", "BUDGET_EXCEEDED"]
          }
        }
      }
    },
    {
      "if": { "properties": { "nodeId": { "const": "R03" } }, "required": ["nodeId"] },
      "then": {
        "properties": {
          "branchCode": {
            "enum": ["NONE", "REWORK_ARCHITECTURE", "NARROW_BASELINE_CONTOUR", "BLOCK_BASELINE_REGRESSION", "BUDGET_EXCEEDED"]
          }
        }
      }
    },
    {
      "if": { "properties": { "nodeId": { "const": "GK" } }, "required": ["nodeId"] },
      "then": {
        "properties": {
          "branchCode": {
            "enum": ["NONE", "INCONCLUSIVE_FOUNDATION", "INCONCLUSIVE_FINALIZATION", "BUDGET_EXCEEDED"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "nodeId": { "const": "R01" }, "outcome": { "const": "SUCCESS" } },
        "required": ["nodeId", "outcome"]
      },
      "then": { "properties": { "branchCode": { "const": "NONE" } } }
    },
    {
      "if": {
        "properties": { "nodeId": { "const": "R02" }, "outcome": { "const": "SUCCESS" } },
        "required": ["nodeId", "outcome"]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "branchCode": { "const": "NONE" },
              "telemetry": {
                "type": "object",
                "properties": { "nativeTokenTelemetryAvailable": { "const": true } },
                "required": ["nativeTokenTelemetryAvailable"]
              }
            }
          },
          {
            "properties": {
              "branchCode": { "const": "TOKEN_TELEMETRY_UNAVAILABLE" },
              "telemetry": {
                "type": "object",
                "properties": { "nativeTokenTelemetryAvailable": { "const": false } },
                "required": ["nativeTokenTelemetryAvailable"]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "nodeId": { "const": "R03" }, "outcome": { "const": "SUCCESS" } },
        "required": ["nodeId", "outcome"]
      },
      "then": { "properties": { "branchCode": { "enum": ["NONE", "NARROW_BASELINE_CONTOUR"] } } }
    },
    {
      "if": {
        "properties": { "nodeId": { "const": "GK" }, "outcome": { "const": "SUCCESS" } },
        "required": ["nodeId", "outcome"]
      },
      "then": { "properties": { "branchCode": { "const": "INCONCLUSIVE_FOUNDATION" } } }
    },
    {
      "if": {
        "properties": {
          "telemetry": {
            "type": "object",
            "properties": { "nativeTokenTelemetryAvailable": { "const": true } },
            "required": ["nativeTokenTelemetryAvailable"]
          }
        },
        "required": ["telemetry"]
      },
      "then": {
        "properties": {
          "metricEligibility": {
            "type": "object",
            "properties": { "nativeTokens": { "const": "AVAILABLE" } },
            "required": ["nativeTokens"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "telemetry": {
            "type": "object",
            "properties": { "nativeTokenTelemetryAvailable": { "const": false } },
            "required": ["nativeTokenTelemetryAvailable"]
          }
        },
        "required": ["telemetry"]
      },
      "then": {
        "properties": {
          "metricEligibility": {
            "type": "object",
            "properties": { "nativeTokens": { "const": "UNAVAILABLE" } },
            "required": ["nativeTokens"]
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "domains": {
                  "type": "array",
                  "not": { "contains": { "const": "TOKEN" } }
                }
              },
              "required": ["domains"]
            }
          },
          "evidenceDelta": {
            "type": "object",
            "properties": {
              "domains": {
                "type": "array",
                "not": { "contains": { "const": "TOKEN" } }
              }
            },
            "required": ["domains"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "outcome": {
      "enum": ["SUCCESS", "FAILURE", "REFUSED", "BLOCKED", "NO_PROGRESS", "INFRA_ERROR"]
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceDigestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref", "sha256"],
      "properties": {
        "role": { "enum": ["S0", "S1", "S2", "S3", "S4", "S5"] },
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "statement", "label", "domains", "evidenceRefs", "falsifiers", "coverageBoundary"],
      "properties": {
        "claimId": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 10 },
        "label": {
          "enum": [
            "CODE",
            "TEST",
            "LITERATURE",
            "EXISTING_SYSTEM",
            "EXISTING_STANDARD",
            "EXISTING_BENCHMARK",
            "OBSERVATION",
            "INFERENCE",
            "HYPOTHESIS",
            "DESIGN_DECISION",
            "HUMAN_DECISION"
          ]
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claimDomain" }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/digestRef" }
        },
        "falsifiers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "coverageBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "claimDomain": {
      "enum": [
        "CONTRACT",
        "FOUNDATION",
        "CORRECTNESS",
        "TIME",
        "TOKEN",
        "COST",
        "APPLICABILITY",
        "SECURITY",
        "COORDINATION",
        "EDITING"
      ]
    },
    "nullableNonnegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeTokenTelemetryAvailable",
        "inputTokens",
        "cachedInputTokens",
        "outputTokens",
        "noncachedTokens",
        "toolCalls",
        "wallMilliseconds",
        "visibleContextBytes"
      ],
      "properties": {
        "nativeTokenTelemetryAvailable": { "type": "boolean" },
        "inputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "cachedInputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "noncachedTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "wallMilliseconds": { "type": "integer", "minimum": 0 },
        "visibleContextBytes": { "type": "integer", "minimum": 0, "maximum": 65536 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "nativeTokenTelemetryAvailable": { "const": true } },
            "required": ["nativeTokenTelemetryAvailable"]
          },
          "then": {
            "properties": {
              "inputTokens": { "type": "integer" },
              "cachedInputTokens": { "type": "integer" },
              "outputTokens": { "type": "integer" },
              "noncachedTokens": { "type": "integer" }
            }
          }
        },
        {
          "if": {
            "properties": { "nativeTokenTelemetryAvailable": { "const": false } },
            "required": ["nativeTokenTelemetryAvailable"]
          },
          "then": {
            "properties": {
              "inputTokens": { "type": "null" },
              "cachedInputTokens": { "type": "null" },
              "outputTokens": { "type": "null" },
              "noncachedTokens": { "type": "null" }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sensitivity"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sensitivity": { "enum": ["PUBLIC", "REPOSITORY_PRIVATE", "SEALED_ORACLE", "REDACTED"] }
      }
    }
  }
}
