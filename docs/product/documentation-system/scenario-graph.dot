digraph DocumentationScenarios {
  rankdir=LR;
  node [shape=box];
  start [label="Documentation request / accepted change", shape=oval];
  end [label="Readable snapshot / explicit gap", shape=oval];
  S01 [label="S01: Register and capture a service"];
  S02 [label="S02: Author a source-bound operation"];
  S03 [label="S03: Describe a declared cross-service scenario"];
  S04 [label="S04: Read a consistent generated publication"];
  S05 [label="S05: Detect changes and review affected explanations"];
  S06 [label="S06: Preserve manual files and recover a publication"];
  S07 [label="S07: Generate a structured service and entity catalogue", style=dashed];
  S08 [label="S08: Author, review and escalate bounded agent work", style=dashed];
  S09 [label="S09: Save a process or entity data-flow view", style=dashed];
  S10 [label="S10: Attach and reassess protected human notes", style=dashed];
  S11 [label="S11: Configure optional evidence modules", style=dashed];
  S12 [label="S12: Update central documentation through CI and inspect history", style=dashed];
  start -> S01;
  S01 -> S02;
  S01 -> S03;
  S03 -> S02;
  S02 -> S04;
  S04 -> S05;
  S04 -> end;
  start -> S05;
  S05 -> S02;
  start -> S06;
  S06 -> S01;
  S06 -> S04;
  S06 -> S05;
  S01 -> S07 [style=dashed, label="increment: durable-documentation"];
  S07 -> S04 [style=dashed, label="increment: durable-documentation"];
  S02 -> S08 [style=dashed, label="increment: durable-documentation"];
  S05 -> S08 [style=dashed, label="increment: durable-documentation"];
  S08 -> S04 [style=dashed, label="increment: durable-documentation"];
  S03 -> S09 [style=dashed, label="increment: durable-documentation"];
  S07 -> S09 [style=dashed, label="increment: durable-documentation"];
  S09 -> S04 [style=dashed, label="increment: durable-documentation"];
  S09 -> S05 [style=dashed, label="increment: durable-documentation"];
  S06 -> S10 [style=dashed, label="increment: durable-documentation"];
  S07 -> S10 [style=dashed, label="increment: durable-documentation"];
  S10 -> S04 [style=dashed, label="increment: durable-documentation"];
  S01 -> S11 [style=dashed, label="increment: durable-documentation"];
  S11 -> S07 [style=dashed, label="increment: durable-documentation"];
  S11 -> S05 [style=dashed, label="increment: durable-documentation"];
  S05 -> S12 [style=dashed, label="increment: durable-documentation"];
  S12 -> S08 [style=dashed, label="increment: durable-documentation"];
  S12 -> S04 [style=dashed, label="increment: durable-documentation"];
