#!/bin/sh
set -eu

unset CODECLEW_RUNTIME_SEED

ENTRYPOINT=$0
LAUNCHER=$0
LINK_HOPS=0
while [ -L "$LAUNCHER" ]; do
  LINK_HOPS=$((LINK_HOPS + 1))
  if [ "$LINK_HOPS" -gt 16 ]; then
    printf '%s\n' '{"schema":"codeclew-installation-error/1.0","error":"installed launcher symlink chain is invalid"}' >&2
    exit 7
  fi
  LINK_TARGET=$(readlink "$LAUNCHER") || exit 7
  case "$LINK_TARGET" in
    /*) LAUNCHER=$LINK_TARGET ;;
    *) LAUNCHER=$(dirname -- "$LAUNCHER")/$LINK_TARGET ;;
  esac
done

LAUNCHER_DIR=$(CDPATH= cd -- "$(dirname -- "$LAUNCHER")" && pwd -P)
RELEASE_ROOT=$(CDPATH= cd -- "$LAUNCHER_DIR/.." && pwd -P)
if [ "${1:-}" = --diagnostics ]; then
  exec python3 -I -S -B "$RELEASE_ROOT/source/bootstrap/diagnostics.py" --launcher "$ENTRYPOINT" "$@"
fi
PROFILE_FILE=$RELEASE_ROOT/PROFILE
[ -f "$PROFILE_FILE" ] && [ ! -L "$PROFILE_FILE" ] || {
  printf '%s\n' '{"schema":"codeclew-installation-error/1.0","error":"installed release profile is unavailable"}' >&2
  exit 7
}
CURRENT_PROFILE=$(sed -n '1p' "$PROFILE_FILE")
case "$CURRENT_PROFILE" in
  core) ;;
  *)
    printf '%s\n' '{"schema":"codeclew-installation-error/1.0","error":"installed release profile is invalid"}' >&2
    exit 7
    ;;
esac

if [ "${1:-}" = skill ]; then
  shift
  SKILL_INSTALLER=$RELEASE_ROOT/source/scripts/install_agent_skill.py
  [ -f "$SKILL_INSTALLER" ] && [ ! -L "$SKILL_INSTALLER" ] || {
    printf '%s\n' 'Codeclew bundled skill installer is unavailable.' >&2
    exit 7
  }
  exec python3 -I -S -B "$SKILL_INSTALLER" "$@"
fi

installed_context() {
  [ -L "$ENTRYPOINT" ] || {
    printf '%s\n' 'This command is available only through the installed launcher.' >&2
    exit 2
  }
  ENTRYPOINT_DIR=$(CDPATH= cd -- "$(dirname -- "$ENTRYPOINT")" && pwd -P)
  RELEASES_DIR=$(CDPATH= cd -- "$RELEASE_ROOT/.." && pwd -P)
  [ "$(basename -- "$RELEASES_DIR")" = releases ] || {
    printf '%s\n' 'Codeclew installed release layout is invalid.' >&2
    exit 7
  }
  INSTALL_ROOT=$(CDPATH= cd -- "$RELEASES_DIR/.." && pwd -P)
  CURRENT_VERSION=$(sed -n '1p' "$RELEASE_ROOT/VERSION")
  INSTALLER_PATH=$RELEASE_ROOT/source/site/install.sh
  [ -f "$INSTALLER_PATH" ] && [ ! -L "$INSTALLER_PATH" ] || {
    printf '%s\n' 'Codeclew bundled installer is unavailable.' >&2
    exit 7
  }
}

if [ "${1:-}" = upgrade ] && [ "$#" -eq 1 ]; then
  installed_context
  UPGRADE_SCRIPT=$RELEASE_ROOT/source/packaging/macos/upgrade
  [ -f "$UPGRADE_SCRIPT" ] && [ ! -L "$UPGRADE_SCRIPT" ] || {
    printf '%s\n' 'Codeclew installed updater is unavailable.' >&2
    exit 7
  }
  CODECLEW_INSTALL_ROOT=$INSTALL_ROOT
  CODECLEW_BIN_DIR=$ENTRYPOINT_DIR
  CODECLEW_CURRENT_VERSION=$CURRENT_VERSION
  CODECLEW_CURRENT_PROFILE=$CURRENT_PROFILE
  CODECLEW_INSTALLER_PATH=$INSTALLER_PATH
  export CODECLEW_INSTALL_ROOT CODECLEW_BIN_DIR CODECLEW_CURRENT_VERSION CODECLEW_CURRENT_PROFILE CODECLEW_INSTALLER_PATH
  exec /bin/sh "$UPGRADE_SCRIPT"
fi

if [ "${1:-}" = pack ]; then
  printf '%s\n' 'Language packs are retired. Core includes the sole Kotlin 2.4.10 analyzer for supported Kotlin projects, including Kotlin 2.3.' >&2
  printf '%s\n' 'Use clew upgrade to update the core installation.' >&2
  exit 2
fi

SEED_PATH=
SEED_COUNT=0
for candidate in "$RELEASE_ROOT"/seed/release-N-*/seed.json; do
  if [ -f "$candidate" ]; then
    SEED_PATH=$candidate
    SEED_COUNT=$((SEED_COUNT + 1))
  fi
done

if [ "$SEED_COUNT" -ne 1 ] || [ ! -x "$RELEASE_ROOT/source/clew" ]; then
  printf '%s\n' '{"schema":"codeclew-installation-error/1.0","error":"installed release is incomplete"}' >&2
  exit 7
fi

CODECLEW_RUNTIME_SEED=$SEED_PATH
export CODECLEW_RUNTIME_SEED
exec "$RELEASE_ROOT/source/clew" "$@"
