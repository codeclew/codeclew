{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "codeclew-documentation-publication/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "released": {
      "type": "boolean",
      "description": "True only when the user explicitly released this render. Omitted in legacy manifests and interpreted as false."
    },
    "parent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "documentationLanguage": {
      "type": "string",
      "enum": ["en", "ru"]
    },
    "targetRevisions": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "freshness": {
            "enum": [
              "CURRENT",
              "STALE",
              "UNVERIFIED"
            ]
          },
          "verification": {
            "type": "string"
          },
          "contentRevisions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "mixedRevisions": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "targetRevisions": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "coverage": {
            "type": "object"
          },
          "reasons": {
            "type": "array"
          }
        },
        "required": [
          "freshness",
          "verification",
          "contentRevisions",
          "targetRevisions",
          "coverage",
          "reasons"
        ]
      },
      "maxProperties": 32768
    },
    "explanationVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "observedTags": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "evidencePackages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "maxProperties": 8192
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "released": {
            "const": true
          }
        },
        "required": ["released"]
      },
      "then": {
        "properties": {
          "ordinal": {
            "minimum": 1
          }
        }
      }
    }
  ],
  "required": [
    "schema",
    "id",
    "parent",
    "ordinal",
    "inputDigest",
    "targetRevisions",
    "sections",
    "explanationVersions",
    "observedTags",
    "evidencePackages",
    "files"
  ]
}
