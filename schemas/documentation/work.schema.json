{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/work.schema.json",
  "title": "Documentation work public records",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/selection"
    },
    {
      "$ref": "#/$defs/page"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "codeclew-documentation-work-request/1.0"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "entrypoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 49152,
          "default": 40960
        },
        "externalInputs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema",
        "audience"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "references": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "query": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "symbolContains": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "untrackedReads": {
          "type": "boolean",
          "default": false
        }
      },
      "required": []
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "codeclew-documentation-work-page/1.0"
        },
        "work": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "contextDigest": {
          "type": "string"
        },
        "inputDigest": {
          "type": "string"
        },
        "authority": {
          "const": "IMMUTABLE_WORK_CAPTURE_NOT_REVERIFIED"
        },
        "influenceCoverage": {
          "enum": [
            "RECORDED_READS_ONLY_EXECUTION_NOT_ATTESTED",
            "INCOMPLETE_UNTRACKED_READS"
          ]
        },
        "membershipDigest": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer"
              },
              "kind": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "const": "ITEM_EXCEEDS_WORK_BYTE_BUDGET"
              }
            },
            "required": [
              "index",
              "kind",
              "id",
              "reference",
              "reason"
            ]
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "receiptDigest": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "work",
        "subject",
        "audience",
        "contextDigest",
        "inputDigest",
        "authority",
        "influenceCoverage",
        "membershipDigest",
        "total",
        "items",
        "omitted",
        "nextCursor",
        "receiptDigest"
      ]
    }
  }
}
