{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/work.schema.json",
  "title": "Documentation work public records",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/selection"
    },
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/sourcePartRequest"
    },
    {
      "$ref": "#/$defs/sourcePart"
    }
  ],
  "$defs": {
    "sourcePartRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "codeclew-documentation-source-part-request/1.0"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "required": [
        "schema",
        "reference"
      ]
    },
    "sourcePart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "codeclew-documentation-source-part/1.0"
        },
        "work": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}/(0|[1-9][0-9]*)$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceId": {
          "type": "string"
        },
        "authority": {
          "const": "IMMUTABLE_WORK_CAPTURE_NOT_REVERIFIED"
        },
        "recordDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source": {
          "$ref": "#/$defs/sourceMetadata"
        },
        "startByte": {
          "type": "integer",
          "minimum": 0
        },
        "endByte": {
          "type": "integer",
          "minimum": 0
        },
        "totalTextBytes": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "fragmentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "receiptType": {
          "const": "SOURCE_PART"
        },
        "receiptDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "work",
        "snapshot",
        "reference",
        "sourceId",
        "authority",
        "recordDigest",
        "source",
        "startByte",
        "endByte",
        "totalTextBytes",
        "text",
        "fragmentDigest",
        "nextCursor",
        "receiptType",
        "receiptDigest"
      ]
    },
    "sourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "startLine": {
          "type": "integer",
          "minimum": 0
        },
        "endLine": {
          "type": "integer",
          "minimum": 0
        },
        "textDigest": {
          "type": "string"
        },
        "evidenceDigest": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "occurrence": {
          "oneOf": [
            {
              "$ref": "#/$defs/sourceOccurrence"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "service",
        "revision",
        "file",
        "startLine",
        "endLine",
        "textDigest",
        "evidenceDigest",
        "authority",
        "url"
      ]
    },
    "sourceOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "type": "string"
        },
        "blob": {
          "type": "string"
        },
        "startByte": {
          "type": "integer",
          "minimum": 0
        },
        "endByte": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "snapshot",
        "blob",
        "startByte",
        "endByte"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "codeclew-documentation-work-request/1.0"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "entrypoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "contextProfile": {
          "type": "string",
          "description": "Compact section orientation, entity-specific orientation for section-entities, bounded declarations-v1 context, source-sharing context for a saved process overview, or bounded direct HTTP API contract preparation. Subject compatibility is validated by the host.",
          "enum": [
            "declarations-v1",
            "http-api-contract-v1",
            "process-v1",
            "section-orientation-v1",
            "section-entities-orientation-v1"
          ]
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 49152,
          "default": 40960
        },
        "externalInputs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "documentationLanguage": {
          "type": "string",
          "enum": [
            "en",
            "ru"
          ],
          "description": "Requested language of authored reader prose. New Work inherits the active publication language, falling back to en before identity is computed; code, source and API identifiers remain unchanged."
        }
      },
      "required": [
        "schema",
        "audience"
      ]
    },
    "selection": {
      "type": "object",
      "description": "Choose at most one active mode: nonempty references, nonempty symbols, or a non-null query. A query kind matches a dependency record's Observation.kind, not a page-row kind such as SOURCE or DEPENDENCY. Use SYMBOL for captured symbols/methods, symbolContains for a case-sensitive substring, and * for all dependency kinds. RAW is the default query projection and preserves full dependency rows. NAVIGATION is available only for SYMBOL and returns small noncitable declaration summaries with fullRecordReference and sourceReferences. Its rows are discovery handles; select an exact symbol or expand a reference to read full evidence. sourceReferences and dependencyReferences are navigation handles; separately expand and record their contents before citing unless already delivered and allowed.",
      "additionalProperties": false,
      "properties": {
        "references": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "query": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "Matches a dependency record's Observation.kind, not the page-row kind. Use * for every dependency kind."
                },
                "symbolContains": {
                  "type": "string",
                  "maxLength": 512,
                  "description": "Case-sensitive substring of captured symbol or method names; empty matches every name within the selected kind."
                },
                "projection": {
                  "type": "string",
                  "enum": ["RAW", "NAVIGATION"],
                  "description": "Optional query view. RAW is the default. NAVIGATION is valid only when kind is SYMBOL."
                }
              },
              "required": [
                "kind"
              ],
              "oneOf": [
                {
                  "properties": {
                    "kind": {"const": "SYMBOL"},
                    "projection": {"const": "NAVIGATION"}
                  },
                  "required": ["projection"]
                },
                {
                  "properties": {
                    "projection": {"const": "RAW"}
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "untrackedReads": {
          "type": "boolean",
          "default": false
        }
      },
      "required": []
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "codeclew-documentation-work-page/1.0"
        },
        "work": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "contextProfile": {
          "type": "string",
          "enum": [
            "declarations-v1",
            "http-api-contract-v1",
            "process-v1",
            "section-orientation-v1",
            "section-entities-orientation-v1"
          ],
          "description": "Compact section orientation, entity-specific orientation for section-entities, bounded declarations-v1 context, source-sharing context for a saved process overview, or bounded direct HTTP API contract preparation. Subject compatibility is validated by the host."
        },
        "subjectReference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string"
            },
            "referenceRoles": {
              "$ref": "#/$defs/referenceRoles"
            }
          },
          "required": [
            "reference",
            "referenceRoles"
          ]
        },
        "contextDigest": {
          "type": "string"
        },
        "snapshot": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}/(0|[1-9][0-9]*)$"
        },
        "inputDigest": {
          "type": "string"
        },
        "authority": {
          "const": "IMMUTABLE_WORK_CAPTURE_NOT_REVERIFIED"
        },
        "influenceCoverage": {
          "enum": [
            "RECORDED_READS_ONLY_EXECUTION_NOT_ATTESTED",
            "INCOMPLETE_UNTRACKED_READS"
          ]
        },
        "membershipDigest": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "referenceRoles": {
                "$ref": "#/$defs/referenceRoles"
              }
            }
          }
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer"
              },
              "kind": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "const": "ITEM_EXCEEDS_WORK_BYTE_BUDGET"
              }
            },
            "required": [
              "index",
              "kind",
              "id",
              "reference",
              "reason"
            ]
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "receiptDigest": {
          "type": "string"
        },
        "documentationLanguage": {
          "type": "string",
          "enum": [
            "en",
            "ru"
          ],
          "description": "Requested language of authored reader prose. New Work inherits the active publication language, falling back to en before identity is computed; code, source and API identifiers remain unchanged."
        }
      },
      "required": [
        "schema",
        "work",
        "subject",
        "audience",
        "contextDigest",
        "inputDigest",
        "authority",
        "influenceCoverage",
        "membershipDigest",
        "total",
        "items",
        "omitted",
        "nextCursor",
        "receiptDigest"
      ]
    },
    "referenceRoles": {
      "type": "array",
      "description": "Advisory capabilities for the proposal handle in reference; only reference values are handles.",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {
        "enum": [
          "evidence",
          "operation",
          "gap"
        ]
      }
    }
  }
}
