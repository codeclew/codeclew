{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/operation-answer-1.2.schema.json",
  "title": "Codeclew documentation operation answer 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packetDigest",
    "title",
    "summary",
    "steps",
    "preparations",
    "uncertainties",
    "glossary",
    "predicates"
  ],
  "properties": {
    "schema": {
      "const": "codeclew-operation-answer/1.2"
    },
    "packetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "$ref": "#/$defs/Claim"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Step"
      }
    },
    "preparations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Preparation"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GlossaryTerm"
      }
    },
    "predicates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Predicate"
      }
    }
  },
  "$defs": {
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence",
        "glossaryRefs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 0
        },
        "uncertainty": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "glossaryRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "meaning",
        "id",
        "glossaryRefs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "action",
            "decision",
            "try",
            "return",
            "throw",
            "loop"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/Claim"
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "interaction": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "otherwise": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "preparationRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "predicateRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "glossaryRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decision"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "children",
              "predicateRef"
            ],
            "properties": {
              "children": {
                "minItems": 1
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "predicateRef"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "try",
                  "loop"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "children"
            ],
            "properties": {
              "children": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "action",
                  "return",
                  "throw"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "otherwise": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "return",
                  "throw"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "children": {
                "maxItems": 0
              },
              "otherwise": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "Preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subjectReference": {
          "type": "string",
          "minLength": 1,
          "description": "Exact declaration/type reference present in this packet. It identifies the source being explained, not concrete runtime dispatch."
        },
        "summary": {
          "$ref": "#/$defs/Claim"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "subjectReference": {
                "type": "string"
              }
            },
            "required": [
              "subjectReference"
            ]
          },
          "then": {},
          "else": {
            "properties": {
              "summary": {
                "required": [
                  "uncertainty"
                ],
                "properties": {
                  "uncertainty": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "GlossaryTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "definition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "business_entity",
            "request",
            "technical_carrier",
            "term"
          ]
        },
        "definition": {
          "$ref": "#/$defs/Claim"
        },
        "subjectRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "technicalNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "meaning",
        "sourceCheck",
        "evaluation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "$ref": "#/$defs/Claim"
        },
        "sourceCheck": {
          "$ref": "#/$defs/Claim"
        },
        "evaluation": {
          "$ref": "#/$defs/Claim"
        }
      }
    }
  }
}
