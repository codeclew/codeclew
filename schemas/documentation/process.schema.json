{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/process.schema.json",
  "title": "Explicit saved documentation process",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "summary",
    "root",
    "process"
  ],
  "properties": {
    "schema": {
      "const": "codeclew-documentation-process/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "root": {
      "$ref": "#/$defs/endpoint"
    },
    "interactions": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
      }
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16,
      "default": 4
    },
    "maxNodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512,
      "default": 64
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "participants",
        "trigger",
        "outcomes"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "participants": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
          },
          "minItems": 1
        },
        "objects": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^entity:[A-Za-z][A-Za-z0-9_-]{0,99}$"
          }
        },
        "trigger": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "linkedSubviews": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
          }
        }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service"
      ],
      "properties": {
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language",
            "owner",
            "name",
            "parameterTypes"
          ],
          "properties": {
            "language": {
              "enum": [
                "java",
                "kotlin",
                "rust"
              ]
            },
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "parameterTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "callSite": {
          "type": "string"
        }
      }
    }
  }
}
