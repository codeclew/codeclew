{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "codeclew-documentation-note-association/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "service": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "pattern": "^notes/.+\\.md$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "enum": [
        "fact",
        "historical-context",
        "policy",
        "intention",
        "opinion",
        "mixed"
      ]
    },
    "period": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    },
    "documentationLanguage": {
      "enum": [
        "en",
        "ru",
        null
      ],
      "description": "Declared language of original note prose; absent or null means unknown. Does not label an assessment or change review authority."
    },
    "sourceBindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {
            "const": "codeclew-note-source-binding/1.0"
          },
          "id": {
            "type": "string"
          },
          "rootNamespace": {
            "type": "string"
          },
          "repositoryId": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "snapshot": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "observationId": {
            "type": "string"
          },
          "textDigest": {
            "type": "string"
          },
          "compilations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startLine": {
            "type": "integer",
            "minimum": 1
          },
          "endLine": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "schema",
          "id",
          "rootNamespace",
          "repositoryId",
          "service",
          "provider",
          "profile",
          "compilations",
          "snapshot",
          "revision",
          "sourceId",
          "startLine",
          "endLine",
          "textDigest"
        ]
      }
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "service",
    "path",
    "targets",
    "classification",
    "period"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Human-controlled association stored separately from exact UTF-8 Markdown. Explicit stable targets; import never overwrites an existing file."
}
