{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/reader-packet.schema.json",
  "title": "Compact documentation reader packet and verification audit",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/audit" },
    { "$ref": "#/$defs/processPacket" },
    { "$ref": "#/$defs/processAudit" }
  ],
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/label" }
    },
    "citationMap": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,31}$": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": { "type": ["string", "null"] },
        "trigger": { "type": ["object", "null"] },
        "boundaries": { "type": "array" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["symbol", "trigger", "boundaries", "evidence"]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"] },
        "typeDescriptor": {},
        "modifiers": { "type": "array" },
        "annotations": { "type": "array" },
        "sourceTokens": { "type": "array" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["name", "typeDescriptor", "modifiers", "annotations", "sourceTokens", "evidence"]
    },
    "typeGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": { "type": "string" },
        "directions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["INPUT", "OUTPUT"] }
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["identity", "directions", "fields", "evidence"]
    },
    "callNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "identity": { "type": "string" },
        "scope": { "type": "string" },
        "source": { "type": ["string", "null"] },
        "bodyId": { "type": ["string", "null"] },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["id", "identity", "scope", "source", "bodyId", "evidence"]
    },
    "receiverField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"] },
        "typeDescriptor": {},
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["name", "typeDescriptor", "evidence"]
    },
    "callEdge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "toNode": { "type": ["string", "null"] },
        "targetIdentity": { "type": ["string", "null"] },
        "kind": { "type": "string" },
        "scope": { "type": ["string", "null"] },
        "authority": {
          "enum": [
            "RETAINED_FLOW_TARGET",
            "COMPILER_EXACT_CALL_RELATION",
            "COMPILER_EXACT_REFERENCE_RELATION",
            "UNVERIFIED_PROVIDER_RELATION",
            "SOURCE_REFERENCE_CANDIDATE"
          ]
        },
        "receiverField": { "$ref": "#/$defs/receiverField" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["from", "toNode", "targetIdentity", "kind", "scope", "authority", "evidence"],
      "anyOf": [
        { "properties": { "toNode": { "type": "string" } } },
        { "properties": { "targetIdentity": { "type": "string" } } }
      ]
    },
    "callMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority": { "const": "RETAINED_TARGET_RELATIONS" },
        "order": { "const": "NOT_EXECUTION_ORDER" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/callNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/callEdge" } }
      },
      "required": ["authority", "order", "nodes", "edges"]
    },
    "methodSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": { "$ref": "#/$defs/label" },
        "sourceAuthority": { "type": "string" },
        "text": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["reference", "sourceAuthority", "text", "evidence"]
    },
    "methodBody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "nodes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/label" },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 0 },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["id", "nodes", "source", "startByte", "endByte", "evidence"]
    },
    "constant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownerIdentity": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "typeDescriptor": {},
        "modifiers": { "type": "array" },
        "annotations": { "type": "array" },
        "sourceTokens": { "type": "array" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["ownerIdentity", "name", "scope", "typeDescriptor", "modifiers", "annotations", "sourceTokens", "evidence"]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage": { "type": ["string", "object", "array"] },
        "runtimeMode": { "type": "string" },
        "boundaries": { "type": "array" },
        "callAuthority": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["coverage", "runtimeMode", "boundaries", "callAuthority", "evidence"]
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      },
      "required": ["code", "count"]
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "codeclew-documentation-reader-packet/1.0" },
        "profile": { "const": "endpoint-context-v3" },
        "authority": { "const": "IMMUTABLE_WORK_CAPTURE_NOT_REVERIFIED" },
        "audience": { "type": "string", "minLength": 1 },
        "documentationLanguage": { "enum": ["en", "ru"] },
        "notice": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "endpoint": { "$ref": "#/$defs/endpoint" },
        "types": { "type": "array", "items": { "$ref": "#/$defs/typeGroup" } },
        "callMap": { "$ref": "#/$defs/callMap" },
        "methodSources": { "type": "array", "items": { "$ref": "#/$defs/methodSource" } },
        "methodBodies": { "type": "array", "items": { "$ref": "#/$defs/methodBody" } },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/ownerField" } },
        "constants": { "type": "array", "items": { "$ref": "#/$defs/constant" } },
        "coverage": { "$ref": "#/$defs/coverage" },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/limitation" } },
        "interpretationLimits": { "type": "array", "items": { "type": "string" } },
        "runtimeAndSerialization": { "const": "UNKNOWN_FROM_THIS_PACKET" },
        "citations": { "$ref": "#/$defs/citationMap" },
        "packetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "required": [
        "schema", "profile", "authority", "audience", "documentationLanguage", "notice", "title", "summary",
        "endpoint", "types", "callMap", "methodSources", "methodBodies", "constants", "coverage", "limitations",
        "interpretationLimits", "runtimeAndSerialization", "citations", "packetDigest"
      ]
    },
    "auditRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/$defs/label" },
        "kind": { "type": "string" },
        "id": { "type": "string" },
        "workReference": { "type": ["string", "null"] },
        "recordDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "deliveredToAuthor": { "const": false },
        "row": { "type": "object" }
      },
      "required": ["label", "kind", "id", "workReference", "recordDigest", "deliveredToAuthor", "row"]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "codeclew-documentation-reader-packet-audit/1.0" },
        "purpose": { "const": "VERIFICATION_ONLY_NOT_DELIVERED_TO_AUTHOR" },
        "workId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "snapshot": { "type": ["string", "null"] },
        "profile": { "const": "endpoint-context-v3" },
        "contextDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "inputDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "packetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "selectedRowsDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bindingDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "auditDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/auditRecord" } }
      },
      "required": [
        "schema", "purpose", "workId", "snapshot", "profile", "contextDigest", "inputDigest", "packetDigest",
        "selectedRowsDigest", "bindingDigest", "auditDigest", "records"
      ]
    },
    "processBody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceReference": { "$ref": "#/$defs/label" },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 0 },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["sourceReference", "startByte", "endByte", "evidence"]
    },
    "processMethod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "symbolIdentity": { "type": "string", "minLength": 1 },
        "ownerIdentity": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "scope": { "type": "string", "minLength": 1 },
        "declarationReference": { "$ref": "#/$defs/label" },
        "body": {
          "oneOf": [
            { "$ref": "#/$defs/processBody" },
            { "type": "null" }
          ]
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["id", "symbolIdentity", "ownerIdentity", "name", "scope", "declarationReference", "body", "evidence"]
    },
    "processEdge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "fromMethodId": { "type": ["string", "null"] },
        "targetMethodId": { "type": ["string", "null"] },
        "targetIdentity": { "type": ["string", "null"] },
        "kind": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "authority": {
          "enum": [
            "RETAINED_FLOW_TARGET",
            "COMPILER_EXACT_PROVIDER_RELATION",
            "UNVERIFIED_PROVIDER_RELATION",
            "SOURCE_REFERENCE_CANDIDATE"
          ]
        },
        "callsiteReference": { "$ref": "#/$defs/label" },
        "sourceReference": { "oneOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
        "receiverFieldReference": { "oneOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["fromMethodId", "targetMethodId", "targetIdentity", "kind", "authority", "evidence"]
    },
    "processField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": { "$ref": "#/$defs/label" },
        "ownerIdentity": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "typeDescriptor": {},
        "modifiers": { "type": "array" },
        "annotations": { "type": "array" },
        "sourceTokens": { "type": "array" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["reference", "ownerIdentity", "name", "typeDescriptor", "modifiers", "annotations", "sourceTokens", "evidence"]
    },
    "ownerField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": { "$ref": "#/$defs/label" },
        "ownerIdentity": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "scope": { "type": "string" },
        "typeDescriptor": {},
        "modifiers": { "type": "array" },
        "annotations": { "type": "array" },
        "sourceTokens": { "type": "array" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["reference", "ownerIdentity", "name", "scope", "typeDescriptor", "modifiers", "annotations", "sourceTokens", "evidence"]
    },
    "processType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": { "$ref": "#/$defs/label" },
        "symbolIdentity": { "type": "string" },
        "declarationKind": { "type": "string" },
        "ownerIdentity": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "superclass": { "type": ["string", "null"] },
        "interfaces": { "type": "array" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["reference", "symbolIdentity", "declarationKind", "ownerIdentity", "name", "scope", "superclass", "interfaces", "evidence"]
    },
    "processSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": { "$ref": "#/$defs/label" },
        "authority": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "contextFor": { "$ref": "#/$defs/label" },
        "contextReferences": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/label" } },
        "sourceAliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference": { "$ref": "#/$defs/label" },
              "authority": { "type": "string", "minLength": 1 },
              "startByte": { "type": "integer", "minimum": 0 },
              "endByte": { "type": "integer", "minimum": 0 },
              "evidence": { "$ref": "#/$defs/evidence" }
            },
            "required": ["reference", "authority", "startByte", "endByte", "evidence"]
          }
        }
      },
      "required": ["reference", "authority", "text", "evidence"]
    },
    "processSourceContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["TYPE_SOURCE", "METHOD_SOURCE", "STATIC_FIELD_REFERENCE", "FIELD_RECEIVER_REFERENCE"] },
        "authority": { "const": "SOURCE_REFERENCE_CANDIDATE" },
        "symbolIdentity": { "type": ["string", "null"] },
        "ownerIdentity": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "declarationReference": { "$ref": "#/$defs/label" },
        "sourceReference": { "oneOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
        "referencedFromSourceReference": { "oneOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["kind", "authority", "symbolIdentity", "ownerIdentity", "scope", "declarationReference", "sourceReference", "referencedFromSourceReference", "evidence"],
      "anyOf": [
        { "properties": { "sourceReference": { "$ref": "#/$defs/label" } } },
        { "properties": { "referencedFromSourceReference": { "$ref": "#/$defs/label" } } }
      ]
    },
    "interactionSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": { "enum": ["java", "kotlin", "rust"] },
        "scope": { "type": "string", "maxLength": 1024 },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "parameterTypes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["language", "owner", "name"]
    },
    "interactionEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$" },
        "selector": { "$ref": "#/$defs/interactionSelector" },
        "callSite": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": { "type": "string", "minLength": 1 },
            "ordinal": { "type": "integer", "minimum": 0 }
          },
          "required": ["target"]
        }
      },
      "required": ["service"]
    },
    "interactionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "codeclew-documentation-interaction/1.0" },
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$" },
        "title": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/interactionEndpoint" },
        "to": { "$ref": "#/$defs/interactionEndpoint" },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "topic": { "type": "string", "maxLength": 249 },
            "method": { "type": "string" },
            "path": { "type": "string" },
            "destinationConfigKey": { "type": "string" }
          },
          "required": ["kind"]
        },
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origin": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 }
          },
          "required": ["origin", "rationale"]
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environments": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["environments"]
        },
        "contractReference": { "type": "string" }
      },
      "required": ["schema", "id", "title", "from", "to", "transport", "declaration"]
    },
    "processIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority": { "const": "USER_INTENTION_NOT_SOURCE_EVIDENCE" },
        "definitionReference": { "$ref": "#/$defs/label" },
        "definitionDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "trigger": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "desiredOutcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "declaredContinuations": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$" },
              "reference": { "$ref": "#/$defs/label" },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "authority": { "const": "DECLARED_INTERACTION_NOT_EXECUTED" },
              "definition": { "$ref": "#/$defs/interactionDefinition" }
            },
            "required": ["id", "reference", "digest", "authority", "definition"]
          }
        },
        "linkedSubviews": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$" },
              "authority": { "const": "USER_INTENTION_ONLY_NOT_RESOLVED_AS_A_CONTINUATION" }
            },
            "required": ["id", "authority"]
          }
        }
      },
      "required": [
        "authority", "definitionReference", "definitionDigest", "title", "summary", "scope", "trigger",
        "desiredOutcomes", "declaredContinuations", "linkedSubviews"
      ]
    },
    "maintainedContext": {
      "type": "object",
      "additionalProperties": false,
      "description": "Complete frozen USER_DOCUMENTATION and historical context, independently UNASSESSED. No record is a compiler citation or a current method body. The host checks all immutable pins and the eight MiB bound.",
      "properties": {
        "schema": {
          "const": "codeclew-maintained-paragraph-context/1.0"
        },
        "selection": {
          "$ref": "work.schema.json#/$defs/maintainedParagraphSelector"
        },
        "subject": {
          "type": "string"
        },
        "serviceDigest": {
          "type": "string"
        },
        "publicationDigest": {
          "type": "string"
        },
        "bindingsDigest": {
          "type": "string"
        },
        "operationDigest": {
          "type": "string"
        },
        "paragraphDigest": {
          "type": "string"
        },
        "contextDigest": {
          "type": "string"
        },
        "contextFreshness": {
          "enum": [
            "CURRENT",
            "STALE"
          ]
        },
        "paragraph": {
          "type": "object",
          "properties": {
            "authorship": {
              "type": "object",
              "properties": {
                "authority": {
                  "const": "USER_DOCUMENTATION"
                },
                "meaningReview": {
                  "const": "UNASSESSED"
                },
                "contextRole": {
                  "const": "RETAINED_UNVERIFIED_CONTEXT"
                }
              }
            }
          },
          "required": [
            "id",
            "text",
            "eventIds",
            "dependencyIds",
            "sourceIds",
            "authorship"
          ]
        },
        "root": {
          "type": "object"
        },
        "rootSources": {
          "type": "object"
        },
        "anchors": {
          "type": "object"
        },
        "sourceRecords": {
          "type": "object"
        },
        "dependencyRecords": {
          "type": "object"
        }
      },
      "required": [
        "schema",
        "selection",
        "subject",
        "serviceDigest",
        "publicationDigest",
        "bindingsDigest",
        "operationDigest",
        "paragraphDigest",
        "contextDigest",
        "contextFreshness",
        "paragraph",
        "root",
        "rootSources",
        "anchors",
        "sourceRecords",
        "dependencyRecords"
      ]
    },
    "processPacket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "codeclew-documentation-reader-packet/1.0" },
        "profile": { "const": "process-graph-v1" },
        "authority": { "const": "IMMUTABLE_WORK_CAPTURE_NOT_REVERIFIED" },
        "audience": { "type": "string", "minLength": 1 },
        "documentationLanguage": { "enum": ["en", "ru"] },
        "notice": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "authority": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "#/$defs/evidence" }
          },
          "required": ["authority", "evidence"]
        },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "methodId": { "type": ["string", "null"] },
            "symbolIdentity": { "type": "string", "minLength": 1 },
            "ownerIdentity": { "type": ["string", "null"] },
            "name": { "type": ["string", "null"] },
            "scope": { "type": ["string", "null"] },
            "declarationReference": { "$ref": "#/$defs/label" },
            "evidence": { "$ref": "#/$defs/evidence" }
          },
          "required": ["methodId", "symbolIdentity", "ownerIdentity", "name", "scope", "declarationReference", "evidence"]
        },
        "methods": { "type": "array", "items": { "$ref": "#/$defs/processMethod" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/processEdge" } },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/processField" } },
        "types": { "type": "array", "items": { "$ref": "#/$defs/processType" } },
        "methodSources": { "type": "array", "items": { "$ref": "#/$defs/processSource" } },
        "sourceContexts": { "type": "array", "items": { "$ref": "#/$defs/processSourceContext" } },
        "processIntent": { "$ref": "#/$defs/processIntent" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "limitations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 1 },
              "examples": { "type": "array" }
            },
            "required": ["code", "count"]
          }
        },
        "interpretationLimits": { "type": "array", "items": { "type": "string" } },
        "graphAuditBinding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": { "type": "string", "minLength": 1 },
            "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "rootMethodId": { "type": ["string", "null"] },
            "snapshot": { "type": "string", "minLength": 1 },
            "service": { "type": "string", "minLength": 1 }
          },
          "required": ["schema", "artifactDigest", "rootMethodId", "snapshot", "service"]
        },
        "maintainedContext": { "$ref": "#/$defs/maintainedContext" },
        "citations": { "$ref": "#/$defs/citationMap" },
        "packetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "required": [
        "schema", "profile", "authority", "audience", "documentationLanguage", "notice", "title", "question",
        "context", "root", "methods", "edges", "fields", "types", "methodSources", "coverage", "limitations",
        "interpretationLimits", "graphAuditBinding", "citations", "packetDigest"
      ]
    },
    "processAudit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "codeclew-documentation-reader-packet-audit/1.0" },
        "purpose": { "const": "VERIFICATION_ONLY_NOT_DELIVERED_TO_AUTHOR" },
        "workId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "snapshot": { "type": ["string", "null"] },
        "profile": { "const": "process-graph-v1" },
        "contextDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "inputDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "packetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "selectedRowsDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bindingDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "auditDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "processGraph": { "type": "object" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/auditRecord" } }
      },
      "required": [
        "schema", "purpose", "workId", "snapshot", "profile", "contextDigest", "inputDigest", "packetDigest",
        "selectedRowsDigest", "bindingDigest", "auditDigest", "processGraph", "records"
      ]
    }
  }
}
