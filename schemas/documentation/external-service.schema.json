{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/external-service.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "description",
    "declaration"
  ],
  "properties": {
    "schema": {
      "const": "codeclew-documentation-external-service/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "repository": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "wiki": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "rationale"
      ],
      "properties": {
        "origin": {
          "enum": [
            "human",
            "agent-proposal",
            "imported"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    }
  }
}
