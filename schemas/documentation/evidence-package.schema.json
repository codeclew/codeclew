{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "enum": [
        "codeclew-documentation-evidence-package/1.0",
        "codeclew-documentation-evidence-package/1.1"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "codeclew-documentation-service/1.0"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "repositoryId": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "language": {
          "enum": [
            "java",
            "kotlin",
            "python"
          ]
        },
        "profile": {
          "type": "string"
        },
        "compilations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roots": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "dialect": {
              "type": "string"
            }
          },
          "required": [
            "roots",
            "dialect"
          ]
        },
        "modules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "codeclew-documentation-modules/1.0"
            },
            "semantic": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "module": {
                  "type": "string"
                },
                "profile": {
                  "type": "string"
                },
                "compilation": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "module",
                "enabled"
              ]
            }
          },
          "required": [
            "schema"
          ]
        },
        "targetRef": {
          "type": "string"
        },
        "sourceLinkTemplate": {
          "type": "string"
        },
        "contractFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceWeb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "webBase"
          ],
          "properties": {
            "provider": {
              "enum": [
                "github",
                "gitlab"
              ]
            },
            "webBase": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      },
      "required": [
        "schema",
        "id",
        "title",
        "repositoryId",
        "repository",
        "language",
        "profile",
        "targetRef"
      ]
    },
    "serviceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "producerVersion": {
      "type": "string",
      "maxLength": 80
    },
    "compatibilityDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "CAPTURED",
        "PRODUCER_FAILURE",
        "DIAGNOSTICS_ONLY"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "header",
              "sources",
              "observations",
              "entrypoints",
              "contracts",
              "report"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^parts/[0-9a-f]{64}\\.json$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "records": {
            "type": "integer",
            "minimum": 1,
            "maximum": 131072
          },
          "encoding": {
            "const": "json"
          }
        },
        "required": [
          "kind",
          "path",
          "digest",
          "bytes",
          "records",
          "encoding"
        ]
      },
      "description": "Native verification enforces at most 2097152 aggregate records and 536870912 aggregate serialized part bytes and 67108864 JSON values plus object keys (including part wrappers), in addition to the structural per-part bounds."
    },
    "retained": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "codeclew-documentation-retained-export/1.0"
        },
        "snapshot": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}/[1-9][0-9]*$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "captureDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cacheability": {
          "enum": [
            "REUSABLE",
            "NON_CACHEABLE"
          ]
        },
        "cacheabilityReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceAuthority": {
          "const": "RETAINED_SOURCE_NOT_REVERIFIED"
        },
        "automaticReuse": {
          "const": "DISALLOWED_HISTORICAL_EXPORT"
        }
      },
      "required": [
        "schema",
        "snapshot",
        "inputDigest",
        "contextDigest",
        "captureDigest",
        "cacheability",
        "sourceAuthority",
        "automaticReuse"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "cacheability": {
                "const": "NON_CACHEABLE"
              }
            }
          },
          "then": {
            "required": [
              "cacheabilityReason"
            ],
            "properties": {
              "cacheabilityReason": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "cacheabilityReason": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "service",
    "serviceDigest",
    "revision",
    "producerVersion",
    "compatibilityDigest",
    "outcome",
    "parts"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "codeclew-documentation-evidence-package/1.1"
          }
        }
      },
      "then": {
        "required": [
          "retained"
        ],
        "properties": {
          "outcome": {
            "const": "CAPTURED"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "retained"
          ]
        }
      }
    }
  ]
}
