{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "codeclew-documentation-evidence-package/1.0"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "codeclew-documentation-service/1.0"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "repositoryId": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "language": {
          "enum": [
            "java",
            "kotlin",
            "python"
          ]
        },
        "profile": {
          "type": "string"
        },
        "compilation": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roots": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "dialect": {
              "type": "string"
            },
            "semantic": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "profile": {
                  "type": "string"
                },
                "compilation": {
                  "type": "string"
                }
              },
              "required": [
                "profile",
                "compilation"
              ]
            }
          },
          "required": [
            "roots",
            "dialect"
          ]
        },
        "modules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "codeclew-documentation-modules/1.0"
            },
            "semantic": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "module": {
                  "type": "string"
                },
                "profile": {
                  "type": "string"
                },
                "compilation": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "module",
                "enabled"
              ]
            }
          },
          "required": [
            "schema"
          ]
        },
        "targetRef": {
          "type": "string"
        },
        "sourceLinkTemplate": {
          "type": "string"
        },
        "contractFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema",
        "id",
        "title",
        "repositoryId",
        "repository",
        "language",
        "profile",
        "targetRef"
      ]
    },
    "serviceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "producerVersion": {
      "type": "string",
      "maxLength": 80
    },
    "compatibilityDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "CAPTURED",
        "PRODUCER_FAILURE",
        "DIAGNOSTICS_ONLY"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "header",
              "sources",
              "observations",
              "entrypoints",
              "contracts",
              "report"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^parts/[0-9a-f]{64}\\.json$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "records": {
            "type": "integer",
            "minimum": 1,
            "maximum": 131072
          },
          "encoding": {
            "const": "json"
          }
        },
        "required": [
          "kind",
          "path",
          "digest",
          "bytes",
          "records",
          "encoding"
        ]
      }
    }
  },
  "required": [
    "schema",
    "service",
    "serviceDigest",
    "revision",
    "producerVersion",
    "compatibilityDigest",
    "outcome",
    "parts"
  ]
}
