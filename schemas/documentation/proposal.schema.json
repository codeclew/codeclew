{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "codeclew-documentation-proposal/1.0"
    },
    "operations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "gaps": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "required": [
    "schema",
    "operations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/proposal.schema.json",
  "title": "Constrained documentation proposal",
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "factEquals is supported only for documented provider fields. Other predicates remain UNKNOWN."
        },
        "evidence": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "expected": {}
      },
      "required": [
        "kind",
        "evidence",
        "field",
        "expected"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "uncertainty": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "required": [
        "text",
        "evidence"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "message",
            "return",
            "note",
            "alt",
            "loop",
            "opt",
            "declared"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/claim"
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "interaction": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "otherwise": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "required": [
        "kind",
        "meaning"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "http",
            "kafka",
            "payload"
          ]
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "description": {
                "$ref": "#/$defs/claim"
              }
            },
            "required": [
              "label",
              "description"
            ]
          }
        }
      },
      "required": [
        "title",
        "kind",
        "rows"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "summary": {
          "$ref": "#/$defs/claim"
        },
        "steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "contracts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "assessment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "outcome": {
                  "enum": [
                    "CONSISTENT",
                    "CONTRADICTED",
                    "HISTORICAL",
                    "UNKNOWN"
                  ]
                },
                "period": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "proposedCorrection": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/claim"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "outcome",
                "period"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Only for a NOTE work reference. Cite the note in the summary. Without source evidence use UNKNOWN, a limitation, and no correction. Periods and historical claims require separate evidence. Never rewrite the original."
        },
        "dataflow": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "nodes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "$ref": "#/$defs/dataflowNode"
                  }
                },
                "edges": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "$ref": "#/$defs/dataflowEdge"
                  }
                }
              },
              "required": [
                "nodes",
                "edges"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Only for docs view prepare: use scenario:<view-id> as entrypoint and empty steps. Summary cites its VIEW_DEFINITION plus code. Domain nodes use exact entity ID/title and cite DOMAIN_ENTITY; other nodes cite source. Name-only edges require candidate/UNKNOWN with meaning.uncertainty. Local read/transform/write edges require source-dataflow and SOURCE_INTERPRETATION; transfer requires declared-contract, DECLARED_TRANSFER, an explicit interaction, source and uncertainty. These classifications do not set review or runtime authority."
        },
        "visuals": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/visual"
          }
        }
      },
      "required": [
        "entrypoint",
        "title",
        "summary",
        "steps"
      ]
    },
    "dataflowNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "entity": {
          "type": "string",
          "pattern": "^entity:[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "kind": {
          "enum": [
            "domain",
            "dto",
            "message",
            "table",
            "field",
            "function"
          ]
        },
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "representation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "meaning": {
          "$ref": "#/$defs/claim"
        }
      },
      "required": [
        "id",
        "entity",
        "kind",
        "service",
        "representation",
        "meaning"
      ]
    },
    "dataflowEdge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "kind": {
          "enum": [
            "read",
            "transform",
            "write",
            "transfer",
            "candidate"
          ]
        },
        "authority": {
          "enum": [
            "SOURCE_INTERPRETATION",
            "DECLARED_TRANSFER",
            "UNKNOWN"
          ]
        },
        "matchBasis": {
          "enum": [
            "source-dataflow",
            "declared-contract",
            "name-only",
            "unknown"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/claim"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "authority",
        "matchBasis",
        "meaning"
      ]
    },
    "visualNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "meaning": {
          "allOf": [
            {
              "$ref": "#/$defs/visualClaim"
            },
            {
              "properties": {
                "text": {
                  "maxLength": 1024,
                  "description": "Nonblank label, at most 1024 UTF-8 bytes. The host additionally enforces byte and control-character limits."
                }
              }
            }
          ]
        }
      },
      "required": [
        "id",
        "meaning"
      ]
    },
    "visualEdge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "meaning": {
          "allOf": [
            {
              "$ref": "#/$defs/visualClaim"
            },
            {
              "properties": {
                "text": {
                  "maxLength": 1024,
                  "description": "Nonblank label, at most 1024 UTF-8 bytes. The host additionally enforces byte and control-character limits."
                }
              }
            }
          ]
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "meaning"
      ]
    },
    "visualRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "condition": {
          "$ref": "#/$defs/visualClaim"
        },
        "outcome": {
          "$ref": "#/$defs/visualClaim"
        }
      },
      "required": [
        "condition",
        "outcome"
      ]
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "execution-flow",
            "dependency-map",
            "decision-table"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose": {
          "$ref": "#/$defs/visualClaim"
        },
        "scope": {
          "$ref": "#/$defs/visualClaim"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "nodes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/visualNode"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/visualEdge"
          }
        },
        "parent": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "artifact": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "node": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                }
              },
              "required": [
                "artifact",
                "node"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "hitPolicy": {
          "enum": [
            "FIRST",
            "UNIQUE",
            "UNKNOWN",
            null
          ]
        },
        "policyExplanation": {
          "oneOf": [
            {
              "$ref": "#/$defs/visualClaim"
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/visualRule"
          }
        },
        "afterSelection": {
          "oneOf": [
            {
              "$ref": "#/$defs/visualClaim"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "purpose",
        "scope",
        "limitations"
      ],
      "description": "A typed source interpretation, atomically versioned with its containing operation. Graphs require nodes and evidence-bound edges, and forbid decision fields. Tables require nonempty rules, hitPolicy and policyExplanation; parent references an execution-flow node in this same operation, or is null for a local decision with unknown global placement. FIRST/UNIQUE are interpretations, not verified executable DMN. Keep action execution failures in afterSelection, outside selection rows.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "execution-flow",
                "dependency-map"
              ]
            },
            "nodes": {
              "minItems": 1
            },
            "parent": {
              "type": "null"
            },
            "hitPolicy": {
              "type": "null"
            },
            "policyExplanation": {
              "type": "null"
            },
            "rules": {
              "maxItems": 0
            },
            "afterSelection": {
              "type": "null"
            }
          },
          "required": [
            "nodes"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "decision-table"
            },
            "nodes": {
              "maxItems": 0
            },
            "edges": {
              "maxItems": 0
            },
            "hitPolicy": {
              "enum": [
                "FIRST",
                "UNIQUE",
                "UNKNOWN"
              ]
            },
            "policyExplanation": {
              "$ref": "#/$defs/visualClaim"
            },
            "rules": {
              "minItems": 1
            }
          },
          "required": [
            "hitPolicy",
            "policyExplanation",
            "rules"
          ]
        }
      ]
    },
    "visualClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "At most 4096 UTF-8 bytes; node and edge labels at most 1024 UTF-8 bytes."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "uncertainty": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "required": [
        "text",
        "evidence"
      ]
    }
  }
}
