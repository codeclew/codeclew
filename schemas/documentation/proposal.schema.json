{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "codeclew-documentation-proposal/1.0"
    },
    "operations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "gaps": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "required": [
    "schema",
    "operations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/proposal.schema.json",
  "title": "Constrained documentation proposal",
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "factEquals is supported only for documented provider fields. Other predicates remain UNKNOWN."
        },
        "evidence": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "expected": {}
      },
      "required": [
        "kind",
        "evidence",
        "field",
        "expected"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "uncertainty": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "required": [
        "text",
        "evidence"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "message",
            "return",
            "note",
            "alt",
            "loop",
            "opt",
            "declared"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/claim"
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "interaction": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "otherwise": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "required": [
        "kind",
        "meaning"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "http",
            "kafka",
            "payload"
          ]
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "description": {
                "$ref": "#/$defs/claim"
              }
            },
            "required": [
              "label",
              "description"
            ]
          }
        }
      },
      "required": [
        "title",
        "kind",
        "rows"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "summary": {
          "$ref": "#/$defs/claim"
        },
        "steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "contracts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "assessment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "outcome": {
                  "enum": [
                    "CONSISTENT",
                    "CONTRADICTED",
                    "HISTORICAL",
                    "UNKNOWN"
                  ]
                },
                "period": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "proposedCorrection": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/claim"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "outcome",
                "period"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Only for a NOTE work reference. Cite the note in the summary. Without source evidence use UNKNOWN, a limitation, and no correction. Periods and historical claims require separate evidence. Never rewrite the original."
        },
        "dataflow": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "nodes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "$ref": "#/$defs/dataflowNode"
                  }
                },
                "edges": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "$ref": "#/$defs/dataflowEdge"
                  }
                }
              },
              "required": [
                "nodes",
                "edges"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Only for docs view prepare: use scenario:<view-id> as entrypoint and empty steps. Summary cites its VIEW_DEFINITION plus code. Domain nodes use exact entity ID/title and cite DOMAIN_ENTITY; other nodes cite source. Name-only edges require candidate/UNKNOWN with meaning.uncertainty. Local read/transform/write edges require source-dataflow and SOURCE_INTERPRETATION; transfer requires declared-contract, DECLARED_TRANSFER, an explicit interaction, source and uncertainty. These classifications do not set review or runtime authority."
        }
      },
      "required": [
        "entrypoint",
        "title",
        "summary",
        "steps"
      ]
    },
    "dataflowNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "entity": {
          "type": "string",
          "pattern": "^entity:[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "kind": {
          "enum": [
            "domain",
            "dto",
            "message",
            "table",
            "field",
            "function"
          ]
        },
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "representation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "meaning": {
          "$ref": "#/$defs/claim"
        }
      },
      "required": [
        "id",
        "entity",
        "kind",
        "service",
        "representation",
        "meaning"
      ]
    },
    "dataflowEdge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "kind": {
          "enum": [
            "read",
            "transform",
            "write",
            "transfer",
            "candidate"
          ]
        },
        "authority": {
          "enum": [
            "SOURCE_INTERPRETATION",
            "DECLARED_TRANSFER",
            "UNKNOWN"
          ]
        },
        "matchBasis": {
          "enum": [
            "source-dataflow",
            "declared-contract",
            "name-only",
            "unknown"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/claim"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "authority",
        "matchBasis",
        "meaning"
      ]
    }
  }
}
