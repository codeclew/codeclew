{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "NONE"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "EXACT"
        },
        "bundle": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "indexDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bindingsDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "bundle",
        "indexDigest",
        "bindingsDigest"
      ]
    }
  ]
}
