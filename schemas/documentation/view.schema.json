{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/view.schema.json",
  "title": "Explicit saved entity data-flow request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "summary",
    "root",
    "view"
  ],
  "properties": {
    "schema": {
      "const": "codeclew-documentation-view/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "root": {
      "$ref": "#/$defs/endpoint"
    },
    "interactions": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
      }
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16,
      "default": 4
    },
    "maxNodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512,
      "default": 64
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "const": "entity-dataflow/1.0"
        },
        "inputObjects": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^entity:[A-Za-z][A-Za-z0-9_-]{0,99}$"
          },
          "minItems": 1
        },
        "services": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
          },
          "minItems": 1
        },
        "contracts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "relatedProcesses": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "human": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "maxProperties": 64,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "tags": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "metadata": {
              "type": "object"
            },
            "layout": {
              "type": "object",
              "maxProperties": 64,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 7
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31
                  }
                },
                "required": [
                  "column",
                  "row"
                ]
              }
            }
          },
          "required": []
        },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "module",
        "inputObjects",
        "services",
        "scope"
      ]
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service"
      ],
      "properties": {
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language",
            "owner",
            "name",
            "parameterTypes"
          ],
          "properties": {
            "language": {
              "enum": [
                "java",
                "kotlin",
                "rust"
              ]
            },
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "parameterTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "callSite": {
          "type": "string"
        }
      }
    }
  }
}
