{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "codeclew-documentation-dataflow/1.0"
    },
    "view": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
    },
    "definitionDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "moduleDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "required": [
    "schema",
    "view",
    "definitionDigest",
    "moduleDigest",
    "nodes",
    "edges"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/dataflow.schema.json",
  "title": "Canonical evidence-bound entity data-flow graph",
  "$defs": {
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "dependencyIds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "sourceIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "text",
        "dependencyIds",
        "sourceIds"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "entity": {
          "type": "string",
          "pattern": "^entity:[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "kind": {
          "enum": [
            "domain",
            "dto",
            "message",
            "table",
            "field",
            "function"
          ]
        },
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "representation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "meaning": {
          "$ref": "#/$defs/fragment"
        }
      },
      "required": [
        "id",
        "entity",
        "kind",
        "service",
        "representation",
        "meaning"
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "kind": {
          "enum": [
            "read",
            "transform",
            "write",
            "transfer",
            "candidate"
          ]
        },
        "authority": {
          "enum": [
            "SOURCE_INTERPRETATION",
            "DECLARED_TRANSFER",
            "UNKNOWN"
          ]
        },
        "matchBasis": {
          "enum": [
            "source-dataflow",
            "declared-contract",
            "name-only",
            "unknown"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/fragment"
        },
        "uncertainty": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "authority",
        "matchBasis",
        "meaning",
        "uncertainty"
      ]
    }
  },
  "description": "Static interpretation, not a runtime trace or universal taint analysis. UNKNOWN name-only candidates cannot be promoted to proven lineage. Each generated graph binds the exact saved view and built-in module."
}
