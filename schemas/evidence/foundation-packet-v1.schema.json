{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/foundation-packet-v1.schema.json",
  "title": "Codeclew optimized foundation packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "nodeId", "attempt", "outcome", "branchCode", "producer", "planRawFileSha256", "approvalRawFileSha256", "manifestRawFileSha256", "sharedDigests", "budgetDigest", "artifactRefs", "parentReceipts", "telemetry", "retryAncestry", "proposedEdges", "humanReadableConclusion", "canonicalScope"],
  "properties": {
    "schemaVersion": {"const": "codeclew-foundation-packet/1"},
    "nodeId": {"enum": ["B01", "B02", "B03", "GB"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "outcome": {"enum": ["SUCCESS", "BLOCKED", "NO_PROGRESS"]},
    "branchCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "producer": {"$ref": "#/$defs/actor"},
    "planRawFileSha256": {"$ref": "#/$defs/sha256"},
    "approvalRawFileSha256": {"$ref": "#/$defs/sha256"},
    "manifestRawFileSha256": {"$ref": "#/$defs/sha256"},
    "sharedDigests": {"$ref": "#/$defs/sharedDigests"},
    "budgetDigest": {"$ref": "#/$defs/sha256"},
    "artifactRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artifactRef"}},
    "parentReceipts": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/parentReceipt"}},
    "telemetry": {"$ref": "#/$defs/telemetry"},
    "retryAncestry": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/retryAncestry"}]},
    "proposedEdges": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(B01|B02|B03|GB)->(B02|B03|GB|K01|GF0)$"}},
    "humanReadableConclusion": {"type": "string", "minLength": 1},
    "canonicalScope": {"const": "JQ_1_7_SORTED_COMPACT_INTEGER_JSON"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["agentId", "sessionId"], "properties": {"agentId": {"type": "string", "minLength": 1}, "sessionId": {"type": "string", "minLength": 1}}},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["path", "rawFileSha256"], "properties": {"path": {"type": "string", "minLength": 1}, "rawFileSha256": {"$ref": "#/$defs/sha256"}}},
    "parentReceipt": {"type": "object", "additionalProperties": false, "required": ["nodeId", "packetRef", "receiptRef"], "properties": {"nodeId": {"enum": ["B02", "B03"]}, "packetRef": {"$ref": "#/$defs/artifactRef"}, "receiptRef": {"$ref": "#/$defs/artifactRef"}}},
    "retryAncestry": {"type": "object", "additionalProperties": false, "required": ["priorPacketRef", "priorReceiptRef", "acceptedRetryable", "priorAttempt", "priorOutcome", "priorBranchCode", "failureFingerprint", "changedPaths", "changedInvariants", "initialAttemptChargedCalls", "retryChargedCalls", "remainingChargedCalls"], "properties": {"priorPacketRef": {"$ref": "#/$defs/artifactRef"}, "priorReceiptRef": {"$ref": "#/$defs/artifactRef"}, "acceptedRetryable": {"const": true}, "priorAttempt": {"const": 1}, "priorOutcome": {"enum": ["BLOCKED", "NO_PROGRESS"]}, "priorBranchCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "failureFingerprint": {"$ref": "#/$defs/sha256"}, "changedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "changedInvariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "initialAttemptChargedCalls": {"type": "integer", "minimum": 1}, "retryChargedCalls": {"type": "integer", "minimum": 0}, "remainingChargedCalls": {"type": "integer", "minimum": 0}}},
    "sharedDigests": {"type": "object", "additionalProperties": false, "required": ["source", "model", "topology", "budgetPolicy"], "properties": {"source": {"$ref": "#/$defs/sha256"}, "model": {"$ref": "#/$defs/sha256"}, "topology": {"$ref": "#/$defs/sha256"}, "budgetPolicy": {"$ref": "#/$defs/sha256"}}},
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nativeTokenTelemetryAvailable", "inputTokens", "cachedInputTokens", "outputTokens", "noncachedTokens", "actionCalls", "waitCalls", "chargedCalls", "wallMilliseconds", "maxVisibleContextBytes"],
      "properties": {
        "nativeTokenTelemetryAvailable": {"type": "boolean"},
        "inputTokens": {"type": ["integer", "null"], "minimum": 0},
        "cachedInputTokens": {"type": ["integer", "null"], "minimum": 0},
        "outputTokens": {"type": ["integer", "null"], "minimum": 0},
        "noncachedTokens": {"type": ["integer", "null"], "minimum": 0},
        "actionCalls": {"type": "integer", "minimum": 0},
        "waitCalls": {"type": "integer", "minimum": 0},
        "chargedCalls": {"type": "integer", "minimum": 0},
        "wallMilliseconds": {"type": "integer", "minimum": 0},
        "maxVisibleContextBytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
