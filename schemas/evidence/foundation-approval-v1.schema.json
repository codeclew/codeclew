{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/foundation-approval-v1.schema.json",
  "title": "Codeclew optimized foundation approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planStatus", "approvalSubject", "approvalSubjectDigest", "humanDecision", "createdAt", "canonicalScope"],
  "properties": {
    "schemaVersion": {"const": "codeclew-foundation-approval/1"},
    "planStatus": {"const": "PROPOSED_AWAITING_HUMAN_APPROVAL"},
    "approvalSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "manifest", "sidecars", "historicalTuple", "currentTaskEvent"],
      "properties": {
        "plan": {"$ref": "#/$defs/artifactRef"},
        "manifest": {"$ref": "#/$defs/artifactRef"},
        "sidecars": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactRef"}},
        "historicalTuple": {"type": "object"},
        "currentTaskEvent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "taskId", "messageId", "authorRole", "messageDigest"],
          "properties": {
            "mode": {"enum": ["NORMAL", "TEST_ONLY"]},
            "taskId": {"type": "string", "minLength": 1},
            "messageId": {"type": "string", "minLength": 1},
            "authorRole": {"const": "USER"},
            "messageDigest": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "approvalSubjectDigest": {"$ref": "#/$defs/sha256"},
    "humanDecision": {"const": "HUMAN_APPROVED"},
    "createdAt": {"type": "string", "minLength": 1},
    "canonicalScope": {"const": "JQ_1_7_SORTED_COMPACT_INTEGER_JSON"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "rawFileSha256"],
      "properties": {
        "role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "path": {"type": "string", "minLength": 1},
        "rawFileSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
