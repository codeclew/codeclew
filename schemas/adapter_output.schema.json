{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/adapter-output/0.1",
  "title": "Codeclew adapter output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapter",
    "snapshotInput",
    "capabilityDescriptors",
    "entities",
    "occurrences",
    "facts",
    "boundaries",
    "compilerReceipt",
    "impact",
    "cost",
    "outputDigest"
  ],
  "properties": {
    "schema": { "const": "codeclew.adapter-output/0.1" },
    "adapter": { "$ref": "#/$defs/adapter" },
    "snapshotInput": { "$ref": "#/$defs/snapshot" },
    "capabilityDescriptors": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "occurrences": {
      "type": "array",
      "items": { "$ref": "#/$defs/occurrence" }
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fact" }
    },
    "boundaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary" }
    },
    "compilerReceipt": { "$ref": "#/$defs/compilerReceipt" },
    "impact": { "$ref": "#/$defs/impact" },
    "cost": { "$ref": "#/$defs/cost" },
    "outputDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterId", "version", "binaryDigest", "languageId"],
      "properties": {
        "adapterId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "binaryDigest": { "$ref": "#/$defs/digest" },
        "languageId": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "normalizedPath",
        "contentDigest",
        "sizeBytes",
        "origin"
      ],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "normalizedPath": { "type": "string", "minLength": 1 },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "origin": {
          "enum": ["USER", "GENERATED", "VENDORED", "EXTERNAL"]
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryTreeDigest",
        "vcsRevision",
        "dirty",
        "sources",
        "buildSystemUri",
        "buildModelDigest",
        "buildConfigurationDigest",
        "dependencyGraphDigest",
        "toolchain",
        "targets",
        "relevantEnvironment",
        "generatedSourcesManifestDigest"
      ],
      "properties": {
        "repositoryTreeDigest": { "$ref": "#/$defs/digest" },
        "vcsRevision": { "type": ["string", "null"] },
        "dirty": { "type": "boolean" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "buildSystemUri": { "type": "string", "minLength": 1 },
        "buildModelDigest": { "$ref": "#/$defs/digest" },
        "buildConfigurationDigest": { "$ref": "#/$defs/digest" },
        "dependencyGraphDigest": { "$ref": "#/$defs/digest" },
        "toolchain": { "$ref": "#/$defs/toolchain" },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
        "relevantEnvironment": { "type": "array", "items": { "$ref": "#/$defs/keyValue" } },
        "generatedSourcesManifestDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "keyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolUri", "version", "distributionDigest"],
      "properties": {
        "toolUri": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "distributionDigest": { "$ref": "#/$defs/digest" },
        "providerPayload": {}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "configurationDigest", "enabledFeatures", "platform", "compilerFlags"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "configurationDigest": { "$ref": "#/$defs/digest" },
        "enabledFeatures": { "type": "array", "items": { "type": "string" } },
        "platform": { "type": "string", "minLength": 1 },
        "compilerFlags": { "type": "array", "items": { "type": "string" } },
        "providerPayload": {}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationUri",
        "languageId",
        "adapterId",
        "adapterVersion",
        "grade",
        "support",
        "guaranteedEnumeration"
        ,"operationVersion"
        ,"operationSpecificationDigest"
        ,"toolchainDigest"
        ,"buildConfigurationDigest"
        ,"targetDigest"
        ,"approximation"
        ,"knownBoundaryKinds"
        ,"costClass"
      ],
      "properties": {
        "operationUri": { "type": "string", "minLength": 1 },
        "languageId": { "type": "string", "minLength": 1 },
        "adapterId": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "grade": { "$ref": "#/$defs/grade" },
        "support": { "enum": ["SUPPORTED", "UNSUPPORTED", "UNKNOWN"] },
        "guaranteedEnumeration": {
          "enum": ["COMPLETE_IN_SCOPE", "PARTIAL", "UNKNOWN"]
        },
        "operationVersion": { "type": "string", "minLength": 1 },
        "operationSpecificationDigest": { "$ref": "#/$defs/digest" },
        "toolchainDigest": { "$ref": "#/$defs/digest" },
        "buildConfigurationDigest": { "$ref": "#/$defs/digest" },
        "targetDigest": { "$ref": "#/$defs/digest" },
        "approximation": {
          "enum": ["EXACT", "SOUND_OVER", "SOUND_UNDER", "HEURISTIC", "NOT_APPLICABLE"]
        },
        "knownBoundaryKinds": { "type": "array", "items": { "type": "string" } },
        "costClass": { "type": "string", "minLength": 1 }
      }
    },
    "grade": {
      "enum": [
        "UNKNOWN",
        "NAVIGATION",
        "COMPILER_RESOLVED",
        "COMPILER_CHECKED",
        "SOUND_STATIC_IN_SCOPE",
        "STATICALLY_APPROXIMATED",
        "TESTED",
        "RUNTIME_OBSERVED"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterNamespace",
        "opaqueId",
        "resolution",
        "coarseKind",
        "displayName"
      ],
      "properties": {
        "adapterNamespace": { "type": "string", "minLength": 1 },
        "opaqueId": { "type": "string", "minLength": 1 },
        "resolution": {
          "enum": ["RESOLVED", "UNRESOLVED", "AMBIGUOUS", "SYNTHETIC"]
        },
        "coarseKind": { "type": "string", "minLength": 1 },
        "displayName": {},
        "primaryDefinition": {},
        "languagePayload": {}
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrenceId", "role", "origin", "grade"],
      "properties": {
        "occurrenceId": { "$ref": "#/$defs/digest" },
        "role": {
          "enum": [
            "DEFINITION",
            "DECLARATION",
            "REFERENCE",
            "CALL",
            "READ",
            "WRITE",
            "IMPORT",
            "EXPORT"
          ]
        },
        "origin": {
          "enum": [
            "SOURCE",
            "GENERATED",
            "SYNTHETIC",
            "MACRO_DERIVED",
            "SOURCE_MAP_DERIVED"
          ]
        },
        "entityId": {},
        "range": {},
        "grade": { "$ref": "#/$defs/grade" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "relation",
        "owner",
        "target",
        "truth",
        "grade",
        "enumeration"
      ],
      "properties": {
        "factId": { "$ref": "#/$defs/digest" },
        "relation": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "target": { "type": "string" },
        "truth": { "enum": ["TRUE", "FALSE", "UNKNOWN"] },
        "grade": { "$ref": "#/$defs/grade" },
        "enumeration": {
          "enum": ["COMPLETE_IN_SCOPE", "PARTIAL", "UNKNOWN"]
        },
        "range": {},
        "providerPayload": {}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundaryId", "kindUri", "consequence"],
      "properties": {
        "boundaryId": { "$ref": "#/$defs/digest" },
        "kindUri": { "type": "string", "minLength": 1 },
        "consequence": {
          "enum": ["LOCAL_ONLY", "ENUMERATION_INCOMPLETE", "PROOF_INVALID"]
        },
        "origin": {},
        "provider": { "type": "string" },
        "details": {}
      }
    },
    "compilerReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "method", "status", "grade", "snapshotTreeDigest", "claim"],
      "properties": {
        "schema": { "const": "codeclew.compiler-receipt/0.1" },
        "method": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ACCEPTED", "REJECTED", "UNKNOWN"] },
        "grade": { "const": "COMPILER_CHECKED" },
        "snapshotTreeDigest": { "$ref": "#/$defs/digest" },
        "claim": { "type": "string", "minLength": 1 },
        "providerPayload": {}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "affected",
        "paths",
        "mandatoryObligations",
        "boundaries"
      ],
      "properties": {
        "schema": { "const": "codeclew.impact-result/0.1" },
        "status": {
          "enum": ["COMPLETE_IN_SCOPE", "PARTIAL_BOUNDARY", "PARTIAL_BUDGET", "UNKNOWN", "REFUSED"]
        },
        "affected": { "type": "array" },
        "paths": { "type": "array" },
        "mandatoryObligations": { "type": "array" },
        "boundaries": { "type": "array" },
        "reason": { "type": "string" },
        "closureSpecification": { "type": "string", "minLength": 1 },
        "seedEntity": { "type": "string", "minLength": 1 },
        "maxDepth": { "type": "integer", "minimum": 0 },
        "maxEntities": { "type": "integer", "minimum": 1 },
        "queryMicros": { "type": "integer", "minimum": 0 },
        "providerPayload": {}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalWallMicros",
        "repositorySnapshotMicros",
        "buildDiscoveryMicros",
        "coldIndexMicros",
        "warmIndexMicros",
        "adapterMicros",
        "queryMicros",
        "sourceBytesRead",
        "emittedBytes",
        "storedFactBytes",
        "modelVisibleSourceBytes",
        "cacheRequests",
        "cacheHits",
        "providerProcessingMicros"
      ],
      "properties": {
        "totalWallMicros": { "type": "integer", "minimum": 0 },
        "repositorySnapshotMicros": { "type": "integer", "minimum": 0 },
        "buildDiscoveryMicros": { "type": "integer", "minimum": 0 },
        "coldIndexMicros": { "type": "integer", "minimum": 0 },
        "warmIndexMicros": { "type": "integer", "minimum": 0 },
        "adapterMicros": { "type": "integer", "minimum": 0 },
        "queryMicros": { "type": "integer", "minimum": 0 },
        "sourceBytesRead": { "type": "integer", "minimum": 0 },
        "emittedBytes": { "type": "integer", "minimum": 0 },
        "storedFactBytes": { "type": "integer", "minimum": 0 },
        "modelVisibleSourceBytes": { "type": "integer", "minimum": 0 },
        "cacheRequests": { "type": "integer", "minimum": 0 },
        "cacheHits": { "type": "integer", "minimum": 0 },
        "providerProcessingMicros": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
