{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/section-author.schema.json",
  "title": "Bound section author result",
  "description": "The controller also enforces UTF-8 byte limits matching the numeric maxLength values below and rejects whitespace-only text. Optional uncertainty may be null or omitted; a supplied string must be nonempty. Evidence items are restricted to handles delivered in this request.",
  "oneOf": [
    {
      "$ref": "#/$defs/sectionAction"
    },
    {
      "$ref": "#/$defs/expandAction"
    }
  ],
  "$defs": {
    "sectionAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "section"
        },
        "section": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "string"
                  }
                },
                "uncertainty": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 2048
                }
              },
              "required": [
                "text",
                "evidence"
              ]
            },
            "uncertainties": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          },
          "required": [
            "title",
            "summary"
          ]
        }
      },
      "required": [
        "action",
        "section"
      ]
    },
    "expandAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "expand"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      },
      "required": [
        "action",
        "selection"
      ]
    },
    "selection": {
      "type": "object",
      "description": "Leave the selection empty for the default context. Choose at most one active mode: nonempty references, nonempty symbols, or a non-null query. Keep the same selection when continuing a page with its cursor. Query kind matches a dependency record's Observation.kind, not a page-row kind such as SOURCE or DEPENDENCY. Use SYMBOL to search captured symbol and method names; symbolContains is a case-sensitive substring. Use * to match every dependency kind. In this role contract, every SYMBOL query is normalized to NAVIGATION, including when projection is omitted or RAW is requested. It returns one bounded, noncitable declaration-discovery page with fullRecordReference and sourceReferences; continue with its cursor to discover more. Request exact symbols or returned references for full records, subject to the existing Work page limits. sourceReferences and dependencyReferences are navigation handles; separately expand and record their contents before citing them unless those contents are already delivered and allowed.",
      "additionalProperties": false,
      "properties": {
        "references": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "query": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "Matches a dependency record's Observation.kind, not the page-row kind. Use * for every dependency kind; availableKinds is supplied in selectionGuidance."
                },
                "symbolContains": {
                  "type": "string",
                  "maxLength": 512,
                  "description": "Case-sensitive substring of captured symbol or method names; empty matches every name within the selected kind."
                },
                "projection": {
                  "type": "string",
                  "enum": ["RAW", "NAVIGATION"],
                  "description": "Requested query view. The role host normalizes every SYMBOL query to NAVIGATION."
                }
              },
              "required": ["kind"],
              "oneOf": [
                {
                  "properties": {
                    "kind": {"const": "SYMBOL"},
                    "projection": {"const": "NAVIGATION"}
                  },
                  "required": ["projection"]
                },
                {
                  "properties": {
                    "projection": {"const": "RAW"}
                  }
                }
              ]
            }
          ]
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "untrackedReads": {
          "const": false
        }
      },
      "oneOf": [
        {
          "properties": {
            "references": {"type": "array", "maxItems": 0},
            "symbols": {"type": "array", "maxItems": 0},
            "query": {"type": "null"}
          }
        },
        {
          "required": ["references"],
          "properties": {
            "references": {"type": "array", "minItems": 1},
            "symbols": {"type": "array", "maxItems": 0},
            "query": {"type": "null"}
          }
        },
        {
          "required": ["symbols"],
          "properties": {
            "references": {"type": "array", "maxItems": 0},
            "symbols": {"type": "array", "minItems": 1},
            "query": {"type": "null"}
          }
        },
        {
          "required": ["query"],
          "properties": {
            "references": {"type": "array", "maxItems": 0},
            "symbols": {"type": "array", "maxItems": 0},
            "query": {"type": "object"}
          }
        }
      ]
    }
  }
}
