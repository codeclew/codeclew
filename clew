#!/bin/sh
set -eu

unset PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT PYTHONWARNINGS PYTHONSAFEPATH

SOURCE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ "${1:-}" = --diagnostics ]; then
  exec python3 -I -S -B "$SOURCE_ROOT/bootstrap/diagnostics.py" --launcher "$SOURCE_ROOT/clew" "$@"
fi
if [ "${1:-}" = pack ]; then
  printf '%s\n' 'Language packs are retired. Core includes the sole Kotlin 2.4.10 analyzer for supported Kotlin projects, including Kotlin 2.3.' >&2
  exit 2
fi
if [ "${1:-}" = skill ]; then
  shift
  exec python3 -I -S -B "$SOURCE_ROOT/scripts/install_agent_skill.py" "$@"
fi
if [ "${1:-}" = upgrade ] && [ "$#" -eq 1 ]; then
  printf '%s\n' 'Codeclew upgrade'
  printf '%s\n' 'Status: FAILED'
  printf '%s\n' 'Error: InvalidInput'
  printf '%s\n' 'This is a source checkout; update it through the approved Git commit or tag.'
  printf '%s\n' 'Retryable: no'
  exit 2
fi
exec python3 -I -S -B "$SOURCE_ROOT/bootstrap/clew_bootstrap.py" --source-root "$SOURCE_ROOT" "$@"
