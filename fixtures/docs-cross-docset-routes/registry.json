            "docset": "orders-docs",
            "page": "incoming.html",
            "anchor": "response"
          }
        }
      ],
      "branches": [
        {
          "id": "success",
          "title": "Described successful path",
          "condition": "The lookup succeeds in this described scope.",
          "target": {
            "docset": "journeys",
            "page": "stock-query.html",
            "anchor": "success"
          }
        }
      ],
