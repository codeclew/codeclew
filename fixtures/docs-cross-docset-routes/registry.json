            "docset": "orders-docs",
            "page": "incoming.html",
            "anchor": "request"
          }
        },
        {
          "id": "b-lookup",
          "actor": {
            "kind": "service",
            "docset": "inventory-docs",
            "service": "api"
          },
          "role": "Perform the documented lookup",
          "target": {
            "docset": "inventory-docs",
            "page": "handler.html",
            "anchor": "lookup"
          }
        },
        {
          "id": "a-return",
          "actor": {
            "kind": "service",
            "docset": "orders-docs",
            "service": "api"
          },
          "role": "Return the result",
