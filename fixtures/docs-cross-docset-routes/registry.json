        "page": "stock-query.html"
      },
      "origin": {
        "status": "known",
        "occurrence": "a-entry",
        "kind": "http",
        "title": "Incoming stock query",
        "summary": "The documented incoming request starts this example."
      },
      "occurrences": [
        {
          "id": "a-entry",
          "actor": {
            "kind": "service",
            "docset": "orders-docs",
            "service": "api"
