{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeclew:semantic-glossary-inputs:1.0",
  "title": "Explicit historical approved glossary selections, without run discovery",
  "type": "array", "minItems": 1, "maxItems": 64,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["input", "service", "work", "reviewRun"],
    "properties": {
      "input": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
      "service": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
      "work": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "reviewRun": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
      "ids": {"type": "array", "maxItems": 32, "uniqueItems": true,
        "items": {"type": "string", "minLength": 1, "maxLength": 256}}
    }
  }
}
