{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/work-batch-request.schema.json",
  "title": "Up to 64 independent recorded SOURCE selections",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "codeclew-documentation-work-batch-request/1.0"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/sourceSelection"
      }
    }
  },
  "required": [
    "schema",
    "selections"
  ],
  "$defs": {
    "sourceSelection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projection": {
              "enum": [
                "CONTEXT",
                "SOURCE_ROWS"
              ]
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string"
              }
            },
            "symbols": {
              "type": "array",
              "maxItems": 0
            },
            "query": {
              "type": "null"
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "untrackedReads": {
              "const": false
            }
          },
          "required": [
            "references"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projection": {
              "const": "CONTEXT"
            },
            "references": {
              "type": "array",
              "maxItems": 0
            },
            "symbols": {
              "type": "array",
              "maxItems": 0
            },
            "query": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "SOURCE"
                },
                "symbolContains": {
                  "type": "string",
                  "maxLength": 0
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "Exact retained SOURCE path; WHOLE_FILE selects one complete original committed Kotlin file or registered non-code input."
                },
                "fileContains": {
                  "type": "string",
                  "maxLength": 1024,
                  "description": "Case-sensitive retained SOURCE path substring; omit with WHOLE_FILE."
                },
                "projection": {
                  "type": "string",
                  "enum": [
                    "RAW",
                    "NAVIGATION",
                    "FILES",
                    "WHOLE_FILE"
                  ],
                  "description": "NAVIGATION supports SYMBOL/SOURCE; FILES is SOURCE navigation grouping only; WHOLE_FILE requires SOURCE and exact file."
                }
              },
              "required": [
                "kind"
              ],
              "anyOf": [
                {
                  "properties": {
                    "kind": {
                      "const": "SYMBOL"
                    },
                    "projection": {
                      "const": "NAVIGATION"
                    },
                    "symbolContains": {}
                  },
                  "additionalProperties": false,
                  "required": [
                    "projection"
                  ]
                },
                {
                  "properties": {
                    "kind": {
                      "const": "SOURCE"
                    },
                    "projection": {
                      "enum": [
                        "RAW",
                        "NAVIGATION",
                        "FILES"
                      ]
                    },
                    "symbolContains": {
                      "const": ""
                    },
                    "file": {},
                    "fileContains": {}
                  },
                  "additionalProperties": false
                },
                {
                  "properties": {
                    "kind": {
                      "const": "SOURCE"
                    },
                    "projection": {
                      "const": "WHOLE_FILE"
                    },
                    "file": {},
                    "fileContains": {
                      "const": ""
                    },
                    "symbolContains": {
                      "const": ""
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "projection",
                    "file"
                  ]
                },
                {
                  "properties": {
                    "kind": {},
                    "symbolContains": {},
                    "projection": {
                      "const": "RAW"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "properties": {
                    "kind": {
                      "const": "FLOW"
                    },
                    "ids": {},
                    "expectedSnapshot": {},
                    "expectedContextDigest": {},
                    "projection": {
                      "const": "RAW"
                    },
                    "symbolContains": {
                      "const": ""
                    }
                  },
                  "required": [
                    "ids"
                  ],
                  "additionalProperties": false
                }
              ],
              "if": {
                "properties": {
                  "kind": {
                    "const": "SOURCE"
                  }
                }
              },
              "then": {
                "properties": {
                  "symbolContains": {
                    "const": ""
                  }
                }
              }
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "untrackedReads": {
              "const": false
            }
          },
          "required": [
            "query"
          ]
        }
      ],
      "description": "Only tracked SOURCE references or SOURCE queries. Native Work membership, per-selection error handling and receipts remain authoritative."
    },
    "selection": {
      "type": "object",
      "description": "Choose nonempty references, nonempty symbols, or query; do not mix modes. Query kind matches Observation.kind; * lists dependencies only, and DEPENDENCY is not a kind. SOURCE requires registered service SOURCE_SCOPE; RAW reads source, NAVIGATION is metadata, FILES groups paths, WHOLE_FILE requires exact retained Kotlin/non-code file. RETAINED_RESOURCE reads retained static resource files without SOURCE_SCOPE: RAW or NAVIGATION, file/fileContains, no configuration resolution. Both source kinds reject nonempty symbolContains and scenario subjects. NAVIGATION is noncitable: expand returned references, drain cursors and recover omitted parts before citing. Discovery establishes neither complete delivery nor parsed/runtime semantics.",
      "additionalProperties": false,
      "properties": {
        "references": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "query": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "Observation.kind, SOURCE, RETAINED_RESOURCE, or * (dependencies only)."
                },
                "symbolContains": {
                  "type": "string",
                  "maxLength": 512,
                  "description": "Case-sensitive dependency symbol substring; SOURCE/RETAINED_RESOURCE require omitted or empty."
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "Exact retained SOURCE/resource path; WHOLE_FILE requires SOURCE."
                },
                "fileContains": {
                  "type": "string",
                  "maxLength": 1024,
                  "description": "Case-sensitive retained SOURCE/resource path substring; omit with WHOLE_FILE."
                },
                "projection": {
                  "type": "string",
                  "enum": [
                    "RAW",
                    "NAVIGATION",
                    "FILES",
                    "WHOLE_FILE"
                  ],
                  "description": "NAVIGATION: SYMBOL/SOURCE/RETAINED_RESOURCE; FILES/WHOLE_FILE: SOURCE only."
                },
                "ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "description": "Exact same-Work FLOW identities; no substring/file filters."
                },
                "expectedSnapshot": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "expectedContextDigest": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "kind"
              ],
              "anyOf": [
                {
                  "properties": {
                    "kind": {
                      "const": "SYMBOL"
                    },
                    "projection": {
                      "const": "NAVIGATION"
                    },
                    "symbolContains": {}
                  },
                  "additionalProperties": false,
                  "required": [
                    "projection"
                  ]
                },
                {
                  "properties": {
                    "kind": {
                      "const": "SOURCE"
                    },
                    "projection": {
                      "enum": [
                        "RAW",
                        "NAVIGATION",
                        "FILES"
                      ]
                    },
                    "symbolContains": {
                      "const": ""
                    },
                    "file": {},
                    "fileContains": {}
                  },
                  "additionalProperties": false
                },
                {
                  "properties": {
                    "kind": {
                      "const": "RETAINED_RESOURCE"
                    },
                    "projection": {
                      "enum": [
                        "RAW",
                        "NAVIGATION"
                      ]
                    },
                    "symbolContains": {
                      "const": ""
                    },
                    "file": {},
                    "fileContains": {}
                  },
                  "additionalProperties": false
                },
                {
                  "properties": {
                    "kind": {
                      "const": "SOURCE"
                    },
                    "projection": {
                      "const": "WHOLE_FILE"
                    },
                    "file": {},
                    "fileContains": {
                      "const": ""
                    },
                    "symbolContains": {
                      "const": ""
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "projection",
                    "file"
                  ]
                },
                {
                  "properties": {
                    "kind": {},
                    "symbolContains": {},
                    "projection": {
                      "const": "RAW"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "properties": {
                    "kind": {
                      "const": "FLOW"
                    },
                    "ids": {},
                    "expectedSnapshot": {},
                    "expectedContextDigest": {},
                    "projection": {
                      "const": "RAW"
                    },
                    "symbolContains": {
                      "const": ""
                    }
                  },
                  "required": [
                    "ids"
                  ],
                  "additionalProperties": false
                }
              ],
              "if": {
                "properties": {
                  "kind": {
                    "const": "SOURCE"
                  }
                }
              },
              "then": {
                "properties": {
                  "symbolContains": {
                    "const": ""
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "untrackedReads": {
          "type": "boolean"
        },
        "projection": {
          "enum": [
            "CONTEXT",
            "SOURCE_ROWS"
          ],
          "description": "SOURCE_ROWS requires tracked SOURCE references, no symbols or query. It returns source rows and source service coverage without narrative expansion."
        }
      },
      "required": []
    }
  }
}
