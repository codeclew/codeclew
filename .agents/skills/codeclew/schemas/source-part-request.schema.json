{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclew.dev/schemas/documentation/source-part-request.schema.json",
  "title": "Recorded SOURCE part request; not the response envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "codeclew-documentation-source-part-request/1.0"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    }
  },
  "required": [
    "schema",
    "reference"
  ]
}
